alertcondition(i_fc and np_up and np_conf>=70. and np_conf[1]<70., "Sentinel: Next Pivot High", "▲ High-confidence next pivot HIGH projection {{ticker}} {{interval}}")
alertcondition(i_fc and not np_up and np_conf>=70. and np_conf[1]<70., "Sentinel: Next Pivot Low", "▼ High-confidence next pivot LOW projection {{ticker}} {{interval}}")

plot(econf, display=display.none, title="Confidence")
plot(esc,   display=display.none, title="Entry Score")
plot(dwcs,  display=display.none, title="DWCS")



// ══════════════════════════════════════════════════════════════
// §SMC PRICE ACTION — Liquidity Sweep / Volume Expansion / Wick Rejection / Break H/L
// ══════════════════════════════════════════════════════════════
G_SMC = "🎯 Smart Price Action"
sh_lsweep = input.bool(false, "Liquidity Sweep",  group=G_SMC, inline="s1")
sh_vexp   = input.bool(false, "Volume Expansion", group=G_SMC, inline="s1")
sh_wick   = input.bool(false, "Wick Rejection",   group=G_SMC, inline="s2")
sh_brkhl  = input.bool(false, "Break Prev H/L",   group=G_SMC, inline="s2")
i_smc_lb  = input.int(10, "Lookback", group=G_SMC, minval=3, maxval=50, inline="s3")
c_lsweep  = input.color(color.new(#FF9800,0),  "Sweep",    group=G_SMC, inline="c_s")
c_vexp    = input.color(color.new(#00BCD4,0),  "VolExp",   group=G_SMC, inline="c_s")
c_wick    = input.color(color.new(#E040FB,0),  "Wick",     group=G_SMC, inline="c_s2")
c_brkhl   = input.color(color.new(#FFEB3B,0),  "BrkHL",    group=G_SMC, inline="c_s2")

// ── Liquidity Sweep: spike ผ่าน swing hi/lo แล้วปิดกลับมาข้างใน (Stop Hunt)
float _smc_hi = ta.highest(high, i_smc_lb)
float _smc_lo = ta.lowest(low,   i_smc_lb)
bool lsweep_bull = low  < _smc_lo[1] and close > _smc_lo[1] and close > open   // เขย่า low แล้วกลับ
bool lsweep_bear = high > _smc_hi[1] and close < _smc_hi[1] and close < open   // เขย่า high แล้วกลับ

// ── Volume Expansion: volume พุ่ง >2× average + body ใหญ่ = institutional push
float vol_avg = ta.sma(volume, 20)
bool vexp_bull = volume > vol_avg * 2.0 and close > open and (close-open)/(high-low+syminfo.mintick) > 0.6
bool vexp_bear = volume > vol_avg * 2.0 and close < open and (open-close)/(high-low+syminfo.mintick) > 0.6

// ── Wick Rejection: wick ยาวกว่า body 2× = rejection แรง (pin bar / hammer)
float _wb     = math.abs(close - open)
float _uwick  = high  - math.max(close, open)
float _lwick  = math.min(close, open) - low
bool wick_bull = _lwick > _wb * 2.0 and _lwick > _uwick * 1.5 and _wb > 0
bool wick_bear = _uwick > _wb * 2.0 and _uwick > _lwick * 1.5 and _wb > 0

// ── Break Previous Candle High/Low: ราคาปิดทะลุ High/Low แท่งก่อน
bool brk_bull = close > high[1] and close > open   // breakout candle high
bool brk_bear = close < low[1]  and close < open   // breakdown candle low

// plotshape บน price chart (force_overlay)
plotshape(sh_lsweep and lsweep_bull, "Sweep Bull", shape.circle,    location.belowbar, c_lsweep, size=size.tiny,  force_overlay=true, text="SWP")
plotshape(sh_lsweep and lsweep_bear, "Sweep Bear", shape.circle,    location.abovebar, c_lsweep, size=size.tiny,  force_overlay=true, text="SWP")
plotshape(sh_vexp   and vexp_bull,   "VolExp Bull", shape.diamond,   location.belowbar, c_vexp,   size=size.small, force_overlay=true, text="V")
plotshape(sh_vexp   and vexp_bear,   "VolExp Bear", shape.diamond,   location.abovebar, c_vexp,   size=size.small, force_overlay=true, text="V")
plotshape(sh_wick   and wick_bull,   "Wick Bull",   shape.triangleup,   location.belowbar, c_wick, size=size.tiny, force_overlay=true, text="W")
plotshape(sh_wick   and wick_bear,   "Wick Bear",   shape.triangledown, location.abovebar, c_wick, size=size.tiny, force_overlay=true, text="W")
plotshape(sh_brkhl  and brk_bull,    "Brk High",    shape.labelup,   location.belowbar, color.new(c_brkhl,50),  size=size.tiny, force_overlay=true, text="B↑", textcolor=color.new(color.black,50))
plotshape(sh_brkhl  and brk_bear,    "Brk Low",     shape.labeldown, location.abovebar, color.new(c_brkhl,50),  size=size.tiny, force_overlay=true, text="B↓", textcolor=color.new(color.black,50))

// alerts
// PLOT-BUDGET FIX: legacy diagnostic alert disabled; core 3L/entry/pivot alerts retained.
// alertcondition(lsweep_bull, "Liquidity Sweep Bull 🟠", "🟠 Liquidity Sweep BULL — stop hunt low confirmed {{ticker}} {{interval}}")
// PLOT-BUDGET FIX: legacy diagnostic alert disabled; core 3L/entry/pivot alerts retained.
// alertcondition(lsweep_bear, "Liquidity Sweep Bear 🟠", "🟠 Liquidity Sweep BEAR — stop hunt high confirmed {{ticker}} {{interval}}")
// PLOT-BUDGET FIX: legacy diagnostic alert disabled; core 3L/entry/pivot alerts retained.
// alertcondition(vexp_bull,   "Volume Expansion Bull 🔵", "🔵 Volume Expansion BULL — institutional push {{ticker}} {{interval}}")
// PLOT-BUDGET FIX: legacy diagnostic alert disabled; core 3L/entry/pivot alerts retained.
// alertcondition(vexp_bear,   "Volume Expansion Bear 🔵", "🔵 Volume Expansion BEAR — institutional push {{ticker}} {{interval}}")
// PLOT-BUDGET FIX: legacy diagnostic alert disabled; core 3L/entry/pivot alerts retained.
// alertcondition(wick_bull,   "Wick Rejection Bull 🟣", "🟣 Wick Rejection BULL — pin bar / hammer {{ticker}} {{interval}}")
// PLOT-BUDGET FIX: legacy diagnostic alert disabled; core 3L/entry/pivot alerts retained.
// alertcondition(wick_bear,   "Wick Rejection Bear 🟣", "🟣 Wick Rejection BEAR — shooting star {{ticker}} {{interval}}")
// PLOT-BUDGET FIX: legacy diagnostic alert disabled; core 3L/entry/pivot alerts retained.
// alertcondition(brk_bull,    "Break Prev High 🟡", "🟡 Break Previous High — breakout {{ticker}} {{interval}}")
// PLOT-BUDGET FIX: legacy diagnostic alert disabled; core 3L/entry/pivot alerts retained.
// alertcondition(brk_bear,    "Break Prev Low 🟡",  "🟡 Break Previous Low — breakdown {{ticker}} {{interval}}")

// ══════════════════════════════════════════════════════════════
// §17 MA/HMA/BOS OVERLAY — วาดบน price chart ด้วย line.new (force_overlay)
// เนื่องจาก plot() ผูกกับ pane MACD จึงเขียนเส้นเป็น segment ต่อแท่ง
// ══════════════════════════════════════════════════════════════
i_ovlMA  = input.bool(true, "Show MA on price chart", group="📈 Moving Averages", inline="ov")
i_ovlBar = input.int(300, "Bars", group="📈 Moving Averages", inline="ov", minval=50, maxval=500)

f_seg(array<line> arr, float y0, float y1, color c, int w) =>
    array.push(arr, line.new(bar_index-1, y0, bar_index, y1, color=c, width=w, force_overlay=true))
    if array.size(arr) > i_ovlBar
        line.delete(array.shift(arr))

var line[] sg_ma1 = array.new<line>()
var line[] sg_ma2 = array.new<line>()
var line[] sg_ma3 = array.new<line>()
var line[] sg_ma4 = array.new<line>()
var line[] sg_hma = array.new<line>()
var line[] sg_bos = array.new<line>()

// label ปลายเส้น MA — วาดใหม่ทุก barstate.islast
var label lb_ma1 = na
var label lb_ma2 = na
var label lb_ma3 = na
var label lb_ma4 = na
var label lb_hma = na

if i_ovlMA and barstate.isconfirmed
    f_seg(sg_ma1, ma1[1], ma1, cEMA12,  1)
    f_seg(sg_ma2, ma2[1], ma2, cSMA26,  1)
    if not i_clean
        f_seg(sg_ma3, ma3[1], ma3, cEMA125, 2)
        f_seg(sg_ma4, ma4[1], ma4, cSMA200, 2)
    f_seg(sg_hma, hma_v[1], hma_v, hma_up?cHMAup:cHMAdn, 2)
    if i_bos and not na(bos_lv) and not na(bos_lv[1])
        f_seg(sg_bos, bos_lv[1], bos_lv, ms_trend==1?cBOS:color.new(color.orange,20), 1)

if i_ovlMA and barstate.islast
    // สร้างชื่อ label ตาม type+length จริง
    string n1 = i_t1+str.tostring(i_ma1)
    string n2 = i_t2+str.tostring(i_ma2)
    string n3 = i_t3+str.tostring(i_ma3)
    string n4 = i_t4+str.tostring(i_ma4)
    string n5 = "HMA"+str.tostring(i_hma)
    label.delete(lb_ma1)
    label.delete(lb_ma2)
    label.delete(lb_ma3)
    label.delete(lb_ma4)
    label.delete(lb_hma)
    lb_ma1 := label.new(bar_index+1, ma1,   n1, color=color.new(color.black,100), textcolor=cEMA12,  style=label.style_label_left, size=size.tiny, force_overlay=true)
    lb_ma2 := label.new(bar_index+1, ma2,   n2, color=color.new(color.black,100), textcolor=cSMA26,  style=label.style_label_left, size=size.tiny, force_overlay=true)
    if not i_clean
        lb_ma3 := label.new(bar_index+1, ma3, n3, color=color.new(color.black,100), textcolor=cEMA125, style=label.style_label_left, size=size.tiny, force_overlay=true)
        lb_ma4 := label.new(bar_index+1, ma4, n4, color=color.new(color.black,100), textcolor=cSMA200, style=label.style_label_left, size=size.tiny, force_overlay=true)
    lb_hma := label.new(bar_index+1, hma_v, n5, color=color.new(color.black,100), textcolor=hma_up?cHMAup:cHMAdn, style=label.style_label_left, size=size.tiny, force_overlay=true)

// ลบเส้นทั้งหมดเมื่อปิด toggle
if not i_ovlMA and barstate.islast
    while array.size(sg_ma1) > 0
        line.delete(array.shift(sg_ma1))
    while array.size(sg_ma2) > 0
        line.delete(array.shift(sg_ma2))
    while array.size(sg_ma3) > 0
        line.delete(array.shift(sg_ma3))
    while array.size(sg_ma4) > 0
        line.delete(array.shift(sg_ma4))
    while array.size(sg_hma) > 0
        line.delete(array.shift(sg_hma))
    while array.size(sg_bos) > 0
        line.delete(array.shift(sg_bos))
