//@version=6
// ═══════════════════════════════════════════════════════════════════════════
// SENTINEL ADAPTIVE STRUCTURE PRECISION  |  รวม Sentinel Signal (overlay บน price chart) เข้ากับ
// MACD pane ล่าง — ใช้เทคนิค force_overlay=true (อ้างอิงโครงสร้างจาก MCDX Plus v2.0)
// MACD แสดงใน pane แยกด้านล่าง | MA/HMA/BOS/Signal/Fib/Forecast/Dashboard ขึ้น price chart
// ═══════════════════════════════════════════════════════════════════════════
indicator("Sentinel Adaptive Structure v1.6 3-Layer FIX", shorttitle="Sentinel AS v1.6F", overlay=false, max_bars_back=500, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// ══════════════════════════════════════════════════════════════
// §0 SENTINEL ADAPTIVE MARKET PRESSURE (SAMP) — PRECISION v2
// Goal: fewer, cleaner signals. A signal must pass context + location + trigger + pressure.
// BUY/SELL is no longer generated by pressure threshold alone.
// ══════════════════════════════════════════════════════════════
G_SAMP = "🧠 Sentinel 3-Layer Adaptive Pressure"
sp_show      = input.bool(true, "Show SAMP", group=G_SAMP)
sp_profile   = input.string("Precision", "Profile", options=["Responsive","Precision","Ultra"], group=G_SAMP)
sp_buy_th    = input.float(32., "Bull Pressure", minval=10., maxval=70., step=1., group=G_SAMP, inline="s1")
sp_sell_th   = input.float(-32., "Bear Pressure", minval=-70., maxval=-10., step=1., group=G_SAMP, inline="s1")
sp_score_th  = input.float(78., "Signal Quality", minval=60., maxval=95., step=1., group=G_SAMP, inline="s2")
sp_cd        = input.int(8, "Min Bars Between Signals", minval=2, maxval=40, group=G_SAMP, inline="s2")
sp_hist      = input.bool(true, "Show Strength Histogram", group=G_SAMP)
sp_show_accel= input.bool(true, "Show Acceleration", group=G_SAMP)
sp_early_alerts = input.bool(true, "Enable Early Turn Alerts", group=G_SAMP)
sp_retest    = input.bool(true, "Require Retest for Breakout", group=G_SAMP)
sp_show_watch= input.bool(false, "Show WATCH markers", group=G_SAMP)

float sp_atr  = ta.atr(14)
float sp_den  = math.max(sp_atr, syminfo.mintick)
float sp_e10  = ta.ema(close,10)
float sp_e20  = ta.ema(close,20)
float sp_e50  = ta.ema(close,50)
float sp_e200 = ta.ema(close,200)
[sp_adx, sp_dip, sp_dim] = ta.dmi(14,14)
float sp_rsi  = ta.rsi(close,14)
float sp_vma  = ta.sma(volume,20)
float sp_rvol = sp_vma>0?volume/sp_vma:1.
float sp_rng  = math.max(high-low, syminfo.mintick)
float sp_body = math.abs(close-open)/sp_rng
float sp_clv  = (close-low)/sp_rng
float sp_atrp = close!=0?sp_atr/close*100.:0.

// Confirmed structure reference. Wider window on Ultra profile reduces micro-noise.
int sp_lb = sp_profile=="Responsive"?6:sp_profile=="Ultra"?14:9
float sp_hi = ta.highest(high,sp_lb)[1]
float sp_lo = ta.lowest(low,sp_lb)[1]
bool sp_bosL = close>sp_hi+sp_atr*0.08 and close[1]<=sp_hi and sp_body>=0.42
bool sp_bosS = close<sp_lo-sp_atr*0.08 and close[1]>=sp_lo and sp_body>=0.42
bool sp_sweepL = low<sp_lo-sp_atr*0.04 and close>sp_lo and sp_clv>0.62 and close>open
bool sp_sweepS = high>sp_hi+sp_atr*0.04 and close<sp_hi and sp_clv<0.38 and close<open
bool sp_hhhl = high>high[2] and low>low[2]
bool sp_lhll = high<high[2] and low<low[2]

// 1) Trend velocity [-100,+100]
float sp_vel1 = (sp_e10-sp_e10[3])/sp_den
float sp_vel2 = (sp_e20-sp_e20[5])/sp_den
float sp_dist = (close-sp_e20)/sp_den
float sp_trend = math.max(-100.,math.min(100.,sp_vel1*36.+sp_vel2*34.+sp_dist*9.))

// 2) Directional pressure [-100,+100]
float sp_diDen = math.max(sp_dip+sp_dim,1.)
float sp_diBias = (sp_dip-sp_dim)/sp_diDen*100.
float sp_dir = math.max(-100.,math.min(100.,sp_diBias*(0.45+math.min(sp_adx,45.)/75.)))

// 3) Structure pressure
float sp_struct = sp_bosL?100.:sp_bosS?-100.:sp_sweepL?82.:sp_sweepS?-82.:sp_hhhl?38.:sp_lhll?-38.:0.

// 4) Price-action pressure
float sp_signedBody = close>open?sp_body:close<open?-sp_body:0.
float sp_closeBias = (sp_clv-0.5)*2.
float sp_pa = math.max(-100.,math.min(100.,sp_signedBody*68.+sp_closeBias*32.))

// 5) Flow / volatility efficiency
float sp_eff = math.abs(close-open)/sp_rng
float sp_flowDir = close>open?1.:close<open?-1.:0.
float sp_flow = sp_flowDir*math.min(100.,math.max(0.,(sp_rvol-0.80)*60.+sp_eff*40.))

// Regime-aware weighting
bool sp_strongTrend = sp_adx>=24. and math.abs(sp_trend)>=32.
bool sp_transition  = not sp_strongTrend and (sp_adx>=16. or sp_bosL or sp_bosS or sp_sweepL or sp_sweepS)
float sp_w_trend  = sp_strongTrend?0.31:sp_transition?0.16:0.10
float sp_w_dir    = sp_strongTrend?0.24:sp_transition?0.16:0.10
float sp_w_struct = sp_strongTrend?0.20:sp_transition?0.30:0.22
float sp_w_pa     = sp_strongTrend?0.10:sp_transition?0.23:0.33
float sp_w_flow   = 0.15
float samp_raw = sp_trend*sp_w_trend+sp_dir*sp_w_dir+sp_struct*sp_w_struct+sp_pa*sp_w_pa+sp_flow*sp_w_flow
int sp_sm = sp_profile=="Responsive"?2:sp_profile=="Ultra"?5:3
float samp = ta.ema(samp_raw,sp_sm)
float samp_slope = samp-samp[2]
float samp_accel = samp_slope-(samp[2]-samp[4])

// Macro context. Precision/Ultra will not repeatedly buy below a falling EMA50 or sell above a rising EMA50.
float sp_e20Slope = (sp_e20-sp_e20[5])/sp_den
float sp_e50Slope = (sp_e50-sp_e50[8])/sp_den
bool sp_macroL = close>sp_e50 and sp_e20Slope>0 and sp_e50Slope>=-0.05 and sp_dip>sp_dim
bool sp_macroS = close<sp_e50 and sp_e20Slope<0 and sp_e50Slope<=0.05 and sp_dim>sp_dip
bool sp_ultraL = sp_macroL and sp_e20>sp_e50 and sp_e50>sp_e200
bool sp_ultraS = sp_macroS and sp_e20<sp_e50 and sp_e50<sp_e200
bool sp_ctxL = sp_profile=="Responsive" ? (close>sp_e20 and sp_dip>=sp_dim) : sp_profile=="Ultra" ? sp_ultraL : sp_macroL
bool sp_ctxS = sp_profile=="Responsive" ? (close<sp_e20 and sp_dim>=sp_dip) : sp_profile=="Ultra" ? sp_ultraS : sp_macroS

// Location/chase filter. Avoid buying into nearby rolling resistance or selling into nearby support.
int sp_locLen = sp_profile=="Responsive"?24:sp_profile=="Ultra"?60:40
float sp_res = ta.highest(high,sp_locLen)[1]
float sp_sup = ta.lowest(low,sp_locLen)[1]
float sp_roomL = (sp_res-close)/sp_den
float sp_roomS = (close-sp_sup)/sp_den
float sp_ext = (close-sp_e20)/sp_den
bool sp_roomOkL = sp_bosL or na(sp_res) or sp_roomL>=0.85
bool sp_roomOkS = sp_bosS or na(sp_sup) or sp_roomS>=0.85
bool sp_chaseOkL = sp_ext<=1.35
bool sp_chaseOkS = sp_ext>=-1.35

// Trigger engines: pullback reclaim, sweep reversal, or breakout + optional retest.
bool sp_pullL = sp_ctxL and low<=sp_e20+sp_atr*0.20 and close>sp_e10 and close>open and sp_clv>0.58 and sp_body>=0.30
bool sp_pullS = sp_ctxS and high>=sp_e20-sp_atr*0.20 and close<sp_e10 and close<open and sp_clv<0.42 and sp_body>=0.30
bool sp_revL  = sp_sweepL and close>sp_e10 and samp_slope>0
bool sp_revS  = sp_sweepS and close<sp_e10 and samp_slope<0

var int sp_bosL_bar = na
var int sp_bosS_bar = na
if sp_bosL
    sp_bosL_bar := bar_index
if sp_bosS
    sp_bosS_bar := bar_index
bool sp_retestL = not na(sp_bosL_bar) and bar_index-sp_bosL_bar>=1 and bar_index-sp_bosL_bar<=4 and low<=sp_hi+sp_atr*0.18 and close>sp_hi and close>open
bool sp_retestS = not na(sp_bosS_bar) and bar_index-sp_bosS_bar>=1 and bar_index-sp_bosS_bar<=4 and high>=sp_lo-sp_atr*0.18 and close<sp_lo and close<open
bool sp_breakL = sp_retest ? sp_retestL : sp_bosL
bool sp_breakS = sp_retest ? sp_retestS : sp_bosS

// Quality score: context and location are mandatory contributors, not optional decorations.
float sp_lq=0.
sp_lq += sp_ctxL?18.:0.
sp_lq += samp>=sp_buy_th?18.:samp>=18.?8.:0.
sp_lq += samp_slope>1.0?12.:0.
sp_lq += samp_accel>0?6.:0.
sp_lq += sp_struct>0?14.:0.
sp_lq += sp_dir>8?10.:0.
sp_lq += sp_trend>8?8.:0.
sp_lq += sp_rvol>=1.10?6.:sp_rvol>=0.90?3.:0.
sp_lq += sp_rsi>=48. and sp_rsi<=68.?5.:0.
sp_lq += sp_roomOkL?7.:0.
sp_lq += sp_chaseOkL?6.:0.
sp_lq -= sp_rsi>74.?12.:0.
sp_lq -= sp_ext>1.8?15.:0.
sp_lq -= close<sp_e20?10.:0.

float sp_sq=0.
sp_sq += sp_ctxS?18.:0.
sp_sq += samp<=sp_sell_th?18.:samp<=-18.?8.:0.
sp_sq += samp_slope<-1.0?12.:0.
sp_sq += samp_accel<0?6.:0.
sp_sq += sp_struct<0?14.:0.
sp_sq += sp_dir<-8?10.:0.
sp_sq += sp_trend<-8?8.:0.
sp_sq += sp_rvol>=1.10?6.:sp_rvol>=0.90?3.:0.
sp_sq += sp_rsi<=52. and sp_rsi>=32.?5.:0.
sp_sq += sp_roomOkS?7.:0.
sp_sq += sp_chaseOkS?6.:0.
sp_sq -= sp_rsi<26.?12.:0.
sp_sq -= sp_ext<-1.8?15.:0.
sp_sq -= close>sp_e20?10.:0.
sp_lq := math.max(0.,math.min(100.,sp_lq))
sp_sq := math.max(0.,math.min(100.,sp_sq))

// Two-bar pressure persistence eliminates one-bar threshold flicker.
bool sp_pressL = samp>=sp_buy_th and samp[1]>=sp_buy_th*0.72 and samp_slope>0
bool sp_pressS = samp<=sp_sell_th and samp[1]<=sp_sell_th*0.72 and samp_slope<0
bool sp_triggerL = sp_pullL or sp_revL or sp_breakL
bool sp_triggerS = sp_pullS or sp_revS or sp_breakS
bool sp_watchL = sp_ctxL and sp_roomOkL and sp_chaseOkL and samp>12 and samp_slope>0 and sp_lq>=sp_score_th-10
bool sp_watchS = sp_ctxS and sp_roomOkS and sp_chaseOkS and samp<-12 and samp_slope<0 and sp_sq>=sp_score_th-10

// State machine: one signal per confirmed setup. Re-arm only after meaningful reset.
var int sp_state=0
var int sp_last=na
var int sp_lastSetup=na
int sp_adaptiveCd = timeframe.in_seconds()>=86400?math.max(sp_cd,8):timeframe.in_seconds()>=14400?math.max(sp_cd,6):sp_cd
bool sp_cdok=na(sp_last) or bar_index-sp_last>=sp_adaptiveCd
bool sp_newSetupL = sp_triggerL and (na(sp_lastSetup) or bar_index-sp_lastSetup>2)
bool sp_newSetupS = sp_triggerS and (na(sp_lastSetup) or bar_index-sp_lastSetup>2)
bool sp_buy = barstate.isconfirmed and sp_cdok and sp_state<=0 and sp_ctxL and sp_roomOkL and sp_chaseOkL and sp_pressL and sp_newSetupL and sp_lq>=sp_score_th
bool sp_sell= barstate.isconfirmed and sp_cdok and sp_state>=0 and sp_ctxS and sp_roomOkS and sp_chaseOkS and sp_pressS and sp_newSetupS and sp_sq>=sp_score_th
if sp_buy
    sp_state:=1
    sp_last:=bar_index
    sp_lastSetup:=bar_index
if sp_sell
    sp_state:=-1
    sp_last:=bar_index
    sp_lastSetup:=bar_index
// Reset only after pressure loses the neutral band AND price loses the fast trend anchor.
if sp_state==1 and samp<5 and close<sp_e20
    sp_state:=0
if sp_state==-1 and samp>-5 and close>sp_e20
    sp_state:=0

// 3-Layer pane: Direction + Strength + Acceleration.
// Direction = regime-adaptive pressure, smoothed to suppress color flicker.
int sp_dirSm = sp_profile=="Responsive"?3:sp_profile=="Ultra"?8:5
float sp_direction = ta.ema(samp, sp_dirSm)
// Strength is magnitude plus directional persistence. It stays 0..100 and is signed only for visual placement.
float sp_persist = math.min(1., math.abs(ta.ema(math.sign(sp_direction), 4)))
float sp_strength_abs = math.min(100., math.abs(sp_direction)*0.78 + math.min(35., sp_adx)*0.55 + sp_persist*10.)
float sp_strength = sp_direction>=0 ? sp_strength_abs : -sp_strength_abs
// Acceleration is normalized change in direction. Extra smoothing keeps it readable.
float sp_acc_raw = (sp_direction-sp_direction[2]) + (sp_direction-sp_direction[1])*0.6
float sp_acc = ta.ema(math.max(-100., math.min(100., sp_acc_raw*2.8)), 3)

// Turning-point states. These do not fire a trade by themselves; they warn that pressure is rotating.
bool sp_earlyBull = barstate.isconfirmed and sp_direction<20 and sp_direction>sp_direction[1] and sp_acc>12 and sp_acc[1]<=12 and sp_struct>=0 and close>=sp_e20
bool sp_earlyBear = barstate.isconfirmed and sp_direction>-20 and sp_direction<sp_direction[1] and sp_acc<-12 and sp_acc[1]>=-12 and sp_struct<=0 and close<=sp_e20
bool sp_strongBull = barstate.isconfirmed and sp_direction>=45 and sp_strength_abs>=55 and sp_acc>0 and sp_ctxL
bool sp_strongBear = barstate.isconfirmed and sp_direction<=-45 and sp_strength_abs>=55 and sp_acc<0 and sp_ctxS

color sp_dir_col = sp_direction>=45?color.lime:sp_direction>=8?color.aqua:sp_direction<=-45?color.red:sp_direction<=-8?color.orange:color.gray
color sp_hist_col = sp_direction>=0?color.new(color.teal,68):color.new(color.red,68)
color sp_acc_col = sp_acc>=0?color.new(color.lime,12):color.new(color.red,12)
plot(sp_show and sp_hist?sp_strength:na,"Layer 2 Momentum Strength",style=plot.style_columns,color=sp_hist_col)
plot(sp_show?sp_direction:na,"Layer 1 Market Direction",color=sp_dir_col,linewidth=3)
plot(sp_show and sp_show_accel?sp_acc:na,"Layer 3 Acceleration",color=sp_acc_col,linewidth=2)
hline(0,"Neutral",color=color.new(color.gray,72))
hline(50,"Strong Bull",color=color.new(color.green,84),linestyle=hline.style_dotted)
hline(-50,"Strong Bear",color=color.new(color.red,84),linestyle=hline.style_dotted)
plotshape(sp_show and sp_show_watch and sp_watchL and not sp_buy,"WATCH L",shape.circle,location.bottom,color=color.new(color.lime,55),size=size.tiny,text="W")
plotshape(sp_show and sp_show_watch and sp_watchS and not sp_sell,"WATCH S",shape.circle,location.top,color=color.new(color.red,55),size=size.tiny,text="W")
plotshape(sp_show and sp_buy,"PRECISION BUY",shape.triangleup,location.bottom,color=color.lime,size=size.small,text="BUY")
plotshape(sp_show and sp_sell,"PRECISION SELL",shape.triangledown,location.top,color=color.red,size=size.small,text="SELL")
plotshape(sp_show and sp_early_alerts and sp_earlyBull and not sp_buy,"EARLY BULL TURN",shape.circle,location.bottom,color=color.new(color.aqua,5),size=size.tiny,text="T+")
plotshape(sp_show and sp_early_alerts and sp_earlyBear and not sp_sell,"EARLY BEAR TURN",shape.circle,location.top,color=color.new(color.orange,5),size=size.tiny,text="T-")

alertcondition(sp_buy,"Sentinel 3L BUY","BUY | 3-Layer pressure + context + location + trigger confirmed | {{ticker}} {{interval}}")
alertcondition(sp_sell,"Sentinel 3L SELL","SELL | 3-Layer pressure + context + location + trigger confirmed | {{ticker}} {{interval}}")
alertcondition(sp_early_alerts and sp_earlyBull,"Sentinel 3L Early Bull Turn","EARLY BULL TURN | acceleration flipped positive before full BUY | {{ticker}} {{interval}}")
alertcondition(sp_early_alerts and sp_earlyBear,"Sentinel 3L Early Bear Turn","EARLY BEAR TURN | acceleration flipped negative before full SELL | {{ticker}} {{interval}}")
alertcondition(sp_strongBull and not sp_strongBull[1],"Sentinel 3L Strong Bull","STRONG BULL PRESSURE | direction + strength + acceleration aligned | {{ticker}} {{interval}}")
alertcondition(sp_strongBear and not sp_strongBear[1],"Sentinel 3L Strong Bear","STRONG BEAR PRESSURE | direction + strength + acceleration aligned | {{ticker}} {{interval}}")

// ══════════════════════════════════════════════════════════════
// §0B OSCILLATOR PANE TOGGLES — OBV / Stoch RSI / ROC (normalize เพื่ออยู่ pane เดียวกับ MACD)
// เปิด/ปิดแต่ละตัวได้อิสระ; ทุกตัว normalize เป็นสเกล -100..+100 ให้เทียบกับ MACD ได้
// ══════════════════════════════════════════════════════════════
G_OBV = "📈 OBV"
sh_obv  = input.bool(false, "Show OBV",      group=G_OBV)
obv_len = input.int(20,  "OBV Norm Length",  group=G_OBV, minval=5, maxval=200)
c_obv   = input.color(#9C27B0, "OBV Color",  group=G_OBV)

G_STR = "📈 Stoch RSI"
sh_str   = input.bool(false, "Show Stoch RSI", group=G_STR)
str_rsiL = input.int(14, "RSI Length",    group=G_STR, minval=1, inline="sr1")
str_stoL = input.int(14, "Stoch Length",  group=G_STR, minval=1, inline="sr1")
str_kS   = input.int(3,  "%K Smooth",     group=G_STR, minval=1, inline="sr2")
str_dS   = input.int(3,  "%D Smooth",     group=G_STR, minval=1, inline="sr2")
c_strK   = input.color(#00BCD4, "%K Color", group=G_STR, inline="sr3")
c_strD   = input.color(#FF9800, "%D Color", group=G_STR, inline="sr3")

G_ROC = "📈 ROC"
sh_roc  = input.bool(false, "Show ROC",  group=G_ROC)
roc_len = input.int(12, "ROC Length",    group=G_ROC, minval=1, inline="rc1")
roc_cap = input.float(20., "ROC Norm Cap %", group=G_ROC, minval=1., inline="rc1", tooltip="ROC% ที่ ±cap จะ map เป็น ±100 บนสเกล normalize")
c_roc   = input.color(#4CAF50, "ROC Color", group=G_ROC)

// ── OBV normalized (pane): ใช้ ta.obv ตรง ๆ ที่นี่ — แยกชื่อจาก obv_raw/obv_norm ของ Sentinel sentiment ด้านล่างเพื่อไม่ชนกัน
float pn_obv_raw  = ta.obv
float pn_obv_hi   = ta.highest(pn_obv_raw, obv_len)
float pn_obv_lo   = ta.lowest(pn_obv_raw, obv_len)
float pn_obv_rng  = math.max(pn_obv_hi - pn_obv_lo, 1.)
float pn_obv_norm = ((pn_obv_raw - pn_obv_lo) / pn_obv_rng - 0.5) * 100.   // -50..+50
plot(sh_obv ? pn_obv_norm : na, "OBV (norm)", color=c_obv, linewidth=2)

// ── Stoch RSI: 0-100 ปรับเป็น -50..+50 ให้กึ่งกลางอยู่ที่ zero line เดียวกับ MACD ──
float str_rsi = ta.rsi(close, str_rsiL)
float str_k0  = ta.sma(ta.stoch(str_rsi, str_rsi, str_rsi, str_stoL), str_kS)
float str_d0  = ta.sma(str_k0, str_dS)
float str_k   = str_k0 - 50.
float str_d   = str_d0 - 50.
plot(sh_str ? str_k : na, "Stoch RSI %K", color=c_strK, linewidth=2)
plot(sh_str ? str_d : na, "Stoch RSI %D", color=c_strD, linewidth=1)

// ── ROC: % เปลี่ยนแปลงดิบ, clamp ±roc_cap แล้ว map เป็น ±100 ──
float roc_raw  = ta.roc(close, roc_len)
float roc_norm = math.max(-100., math.min(100., roc_raw / roc_cap * 100.))
plot(sh_roc ? roc_norm : na, "ROC (norm)", color=c_roc, linewidth=2)

// ══════════════════════════════════════════════════════════════
// §1+ SENTINEL SIGNAL (ทุก object ใช้ force_overlay=true ขึ้น price chart)
// ══════════════════════════════════════════════════════════════
// ══════════════════════════════════════════════════════════════
// §1 INPUTS
// ══════════════════════════════════════════════════════════════
G_MA    = "📈 Moving Averages"
i_t1    = input.string("EMA", "MA1 Type", group=G_MA, options=["EMA","SMA","HMA","WMA"], inline="1")
i_ma1   = input.int(12,  "",             group=G_MA, inline="1", minval=1)
i_t2    = input.string("SMA", "MA2 Type", group=G_MA, options=["EMA","SMA","HMA","WMA"], inline="2")
i_ma2   = input.int(26,  "",             group=G_MA, inline="2", minval=1)
i_t3    = input.string("EMA", "MA3 Type", group=G_MA, options=["EMA","SMA","HMA","WMA"], inline="3")
i_ma3   = input.int(125, "",             group=G_MA, inline="3", minval=1)
i_t4    = input.string("SMA", "MA4 Type", group=G_MA, options=["EMA","SMA","HMA","WMA"], inline="4")
i_ma4   = input.int(200, "",             group=G_MA, inline="4", minval=1)
i_hma   = input.int(21,  "HMA Len",      group=G_MA, inline="5", minval=3)
i_bos   = input.bool(true,"BOS Line",    group=G_MA, inline="5")

G_CORE  = "⚙️ Core"
i_rsi   = input.int(14, "RSI",    group=G_CORE, inline="1", minval=2)
i_adx   = input.int(14, "ADX",    group=G_CORE, inline="1", minval=2)
i_swing = input.int(10, "Swing",  group=G_CORE, inline="1", minval=3, maxval=30)
i_atr   = input.int(14, "ATR",    group=G_CORE, inline="2", minval=2)
i_volma = input.int(20, "Vol MA", group=G_CORE, inline="2", minval=5)

G_SIG   = "🎯 Signal Gate"
i_conf  = input.float(60., "Min Confidence %", group=G_SIG, minval=40., maxval=90., step=5.)
i_rr    = input.float(1.5, "Min R:R",          group=G_SIG, minval=1.0, maxval=3.0, step=0.1)
i_ftp   = input.float(1.618, "Fib Target",     group=G_SIG, step=0.1)
i_tfc   = input.string("15m+1H+4H", "TF Combo", group=G_SIG, options=["15m+1H+4H","15m+1H+4H+D"])



G_DSH   = "📊 Display"
G_CLR   = "🎨 Line Colors"
i_clean = input.bool(true, "Clean Chart Mode", group=G_DSH, tooltip="Shows only decision-useful overlays by default. Disable for full legacy overlays.")
i_dpos  = input.string("Top Right","Dashboard",group=G_DSH,options=["Top Right","Top Left","Bottom Right","Bottom Left"])
i_div   = input.bool(false, "Divergence Labels", group=G_DSH)
i_fib   = input.bool(true, "Auto Fibonacci",     group=G_DSH)
i_fc    = input.bool(true, "Next Pivot Prediction", group=G_DSH, inline="f")
i_fcb   = input.int(5,     "Bars",               group=G_DSH, inline="f", minval=3, maxval=40)

G_SR    = "🧱 Adaptive Support / Resistance"
i_sr    = input.bool(true, "Show Adaptive S/R", group=G_SR)
i_sr_n  = input.int(2, "Levels Each Side", minval=1, maxval=3, group=G_SR, inline="sr1")
i_sr_atr= input.float(0.22, "Zone ATR", minval=0.08, maxval=0.60, step=0.02, group=G_SR, inline="sr1")
i_sr_min= input.float(48., "Min Strength", minval=20., maxval=90., step=1., group=G_SR)
i_sr_htf= input.bool(true, "Include HTF Structure", group=G_SR)
// ชื่อ color label ใน settings = MA1–MA4 เพราะ input.string type selector อยู่แยกกัน
// ปลายเส้นบน chart จะแสดงชื่อตาม type+length จริง เช่น "EMA12", "SMA26"
cEMA12  = input.color(color.new(color.lime,30),   "MA1",  group=G_CLR, inline="c1")
cSMA26  = input.color(color.new(color.yellow,30), "MA2",  group=G_CLR, inline="c1")
cEMA125 = input.color(color.new(color.orange,25), "MA3",  group=G_CLR, inline="c2")
cSMA200 = input.color(color.new(color.purple,20), "MA4",  group=G_CLR, inline="c2")
cHMAup  = input.color(color.new(color.aqua,20),   "HMA Up",    group=G_CLR, inline="c3")
cHMAdn  = input.color(color.new(color.red,20),    "HMA Down",  group=G_CLR, inline="c3")
cFCbase = input.color(color.new(color.aqua,15),   "Forecast",  group=G_CLR, inline="c4")
cFibKey = input.color(color.new(color.orange,35), "Fib 61.8",  group=G_CLR, inline="c4")
cFibTgt = input.color(color.new(color.fuchsia,20),"Fib Target",group=G_CLR, inline="c5")
cBOS    = input.color(color.new(color.fuchsia,20),"BOS",       group=G_CLR, inline="c5")

G_MTF   = "🔢 MTF Timeframes"
i_amtf  = input.bool(true, "Auto MTF (ปรับตาม TF กราฟ)", group=G_MTF)
i_htf1  = input.timeframe("W",   "Manual: High", group=G_MTF, inline="1")
i_htf2  = input.timeframe("D",   "Mid",          group=G_MTF, inline="1")
i_htf3  = input.timeframe("240", "Low",          group=G_MTF, inline="1")

// Auto ladder ตาม TF กราฟ:
//   ≥1W → M/W/D | ≥1D → W/D/4H | >1H..4H → 4H/1H/15m | ≤1H → 1H/30m/15m + 5m (4 TF)
f_tfs(string s) => s=="240"?"4H":s=="60"?"1H":s=="30"?"30m":s=="15"?"15m":s=="5"?"5m":s=="12M"?"1Y":s
int  _chs = timeframe.in_seconds()
bool _cwk = _chs>=604800
bool _cdy = _chs>=86400 and not _cwk
bool _c1h = _chs<=3600
string u_tf1 = i_amtf?(_cwk?"M":_cdy?"W":_c1h?"60":"240"):i_htf1
string u_tf2 = i_amtf?(_cwk?"W":_cdy?"D":_c1h?"30":"60"):i_htf2
string u_tf3 = i_amtf?(_cwk?"D":_cdy?"240":"15"):i_htf3
bool  use_m5 = i_amtf and _c1h                               // เปิด TF ที่ 4 (5m) เมื่อดู ≤1H
string e_lo  = i_amtf?(_cwk?"D":_cdy?"240":_c1h?"5":"15"):"15"
string e_mid = i_amtf?(_cwk?"W":_cdy?"D":_c1h?"15":"60"):"60"
string e_hi  = i_amtf?(_cwk?"M":_cdy?"W":_c1h?"60":"240"):"240"
string e_dtf = i_amtf?(_cwk?"3M":_cdy?"M":_c1h?"240":"D"):"D"

// ══════════════════════════════════════════════════════════════
// §2 HELPERS
// ══════════════════════════════════════════════════════════════
f_clamp(v, lo, hi) => math.max(lo, math.min(hi, v))
f_pos(p) =>
    p=="Top Right"?position.top_right:p=="Bottom Right"?position.bottom_right: p=="Top Left"?position.top_left:position.bottom_left

// [F1] Correct Hull Moving Average formula
// Original bug: hma = (ema_fast + ema_slow) / 2  ← just average of two EMAs
f_hma(src, len) =>
    h = math.round(len / 2)
    s = math.round(math.sqrt(float(len)))
    ta.wma(2.0 * ta.wma(src, h) - ta.wma(src, len), s)

// Helper functions for security calls
f_macdh() =>
    [_, _, h] = ta.macd(close, 12, 26, 9)
    h
f_vr() =>
    vm = ta.sma(volume, 20)
    vm > 0 ? volume / vm : 1.

// ══════════════════════════════════════════════════════════════
// §3 MOVING AVERAGES — ปรับประเภทได้: EMA / SMA / HMA / WMA
// ══════════════════════════════════════════════════════════════
f_ma(string t, float src, int len) =>
    t == "SMA" ? ta.sma(src, len) : t == "HMA" ? f_hma(src, len) : t == "WMA" ? ta.wma(src, len) : ta.ema(src, len)
ma1    = f_ma(i_t1, close, i_ma1)
ma2    = f_ma(i_t2, close, i_ma2)
ma3    = f_ma(i_t3, close, i_ma3)
ma4    = f_ma(i_t4, close, i_ma4)
hma_v  = f_hma(close, i_hma)
hma_up = hma_v > hma_v[1]

// [moved to force_overlay section] plot(ma1,   "EMA12",  color=cEMA12,  linewidth=1)
// [moved to force_overlay section] plot(ma2,   "SMA26",  color=cSMA26,  linewidth=1)
// [moved to force_overlay section] plot(ma3,   "EMA125", color=cEMA125, linewidth=2)
// [moved to force_overlay section] plot(ma4,   "SMA200", color=cSMA200, linewidth=2)
// [moved to force_overlay section] plot(hma_v, "HMA",    color=hma_up?cHMAup:cHMAdn, linewidth=2)

// ══════════════════════════════════════════════════════════════
// §4 CORE INDICATORS
// ══════════════════════════════════════════════════════════════
atr_v   = ta.atr(i_atr)
vol_ma  = ta.sma(volume, i_volma)
rsi_v   = ta.rsi(close, i_rsi)
[_, _, mh] = ta.macd(close, 12, 26, 9)
[adx_v, dip, dim] = ta.dmi(i_adx, i_adx)
stoch_v = ta.stoch(close, high, low, 14)
vol_r   = vol_ma > 0 ? volume / vol_ma : 1.
roc5    = close > 0 ? (close - close[5]) / close[5] * 100. : 0.

// [F2] CVD — direction-based (original used price-position proxy = unreliable OFS)
float cvd_tick = close > open ? volume : close < open ? -volume : 0.
var float cvd  = 0.
cvd           := cvd + cvd_tick
float cvd_sl   = cvd - cvd[5]
bool  cvd_bull = cvd_sl > 0
bool  cvd_bear = cvd_sl < 0

bool vol_surge    = vol_r > 2.5
bool vol_anom_bull= vol_r > 2.0 and close > open and (close-open)/math.max(high-low,syminfo.mintick) > 0.5
bool vol_anom_bear= vol_r > 2.0 and close < open and (open-close)/math.max(high-low,syminfo.mintick) > 0.5

// ══════════════════════════════════════════════════════════════
// §5 BOS — confirmed bars only, no repaint
// ══════════════════════════════════════════════════════════════
var float sw_hi    = na
var float sw_lo    = na
var int   sw_hi_b  = 0
var int   sw_lo_b  = 0
float _rhi = ta.highest(high, i_swing)
float _rlo = ta.lowest(low,  i_swing)

// [F3] Only update swing levels on confirmed bars — prevents live-bar repaint
if barstate.isconfirmed
    if high >= _rhi
        sw_hi  := high
        sw_hi_b:= bar_index
    if low <= _rlo
        sw_lo  := low
        sw_lo_b:= bar_index

var int   ms_trend = 0
var float bos_lv   = na
float _body = (high-low) > 0 ? math.abs(close-open)/(high-low) : 0.
bool bos_bull = barstate.isconfirmed and not na(sw_hi) and close > sw_hi and close > open and _body >= 0.40 and ms_trend <= 0
bool bos_bear = barstate.isconfirmed and not na(sw_lo) and close < sw_lo and close < open and _body >= 0.40 and ms_trend >= 0

if bos_bull
    ms_trend := 1
    bos_lv   := sw_lo
if bos_bear
    ms_trend := -1
    bos_lv   := sw_hi

// Liquidity sweep detection
var bool bull_sw = false
var bool bear_sw = false
var int  _bcd = 0
var int  _scd2 = 0
_bcd  := math.max(0, _bcd  - 1)
_scd2 := math.max(0, _scd2 - 1)
if barstate.isconfirmed
    if low  < sw_lo and close > sw_lo + atr_v*0.3 and _bcd  == 0
        _bcd  := 5
    if high > sw_hi and close < sw_hi - atr_v*0.3 and _scd2 == 0
        _scd2 := 5
bull_sw := _bcd  > 0
bear_sw := _scd2 > 0

// [moved to force_overlay section] plot(i_bos ? bos_lv : na, "BOS", color=ms_trend==1?cBOS:color.new(color.orange,20), linewidth=1, style=plot.style_stepline_diamond)

// ══════════════════════════════════════════════════════════════
// §6 MTF HIERARCHY
// ══════════════════════════════════════════════════════════════
w_c   = request.security(syminfo.tickerid, u_tf1, close,              lookahead=barmerge.lookahead_off)
w_e20 = request.security(syminfo.tickerid, u_tf1, ta.ema(close,20),   lookahead=barmerge.lookahead_off)
w_e50 = request.security(syminfo.tickerid, u_tf1, ta.ema(close,50),   lookahead=barmerge.lookahead_off)
w_rsi = request.security(syminfo.tickerid, u_tf1, ta.rsi(close,14),   lookahead=barmerge.lookahead_off)
d_c   = request.security(syminfo.tickerid, u_tf2, close,              lookahead=barmerge.lookahead_off)
d_e20 = request.security(syminfo.tickerid, u_tf2, ta.ema(close,20),   lookahead=barmerge.lookahead_off)
d_e50 = request.security(syminfo.tickerid, u_tf2, ta.ema(close,50),   lookahead=barmerge.lookahead_off)
d_rsi = request.security(syminfo.tickerid, u_tf2, ta.rsi(close,14),   lookahead=barmerge.lookahead_off)
h4_c  = request.security(syminfo.tickerid, u_tf3, close,              lookahead=barmerge.lookahead_off)
h4_20 = request.security(syminfo.tickerid, u_tf3, ta.ema(close,20),   lookahead=barmerge.lookahead_off)
h4_50 = request.security(syminfo.tickerid, u_tf3, ta.ema(close,50),   lookahead=barmerge.lookahead_off)
h4_rs = request.security(syminfo.tickerid, u_tf3, ta.rsi(close,14),   lookahead=barmerge.lookahead_off)
h4_at = request.security(syminfo.tickerid, u_tf3, ta.atr(14),         lookahead=barmerge.lookahead_off)
h4_hi = request.security(syminfo.tickerid, u_tf3, ta.highest(high,20),lookahead=barmerge.lookahead_off)
h4_lo = request.security(syminfo.tickerid, u_tf3, ta.lowest(low,20),  lookahead=barmerge.lookahead_off)

// [F4] Equal 33/33/33 weighting (was 50/33/17 — weekly dominated)
// [F4] RSI zone >55/<45 instead of >50 — less noise in ranging markets
float mtf_ws = (w_c>w_e20?1.:-1.) + (w_e20>w_e50?1.:-1.) + (w_rsi>55.?1.:w_rsi<45.?-1.:0.)
float mtf_ds = (d_c>d_e20?1.:-1.) + (d_e20>d_e50?1.:-1.) + (d_rsi>55.?1.:d_rsi<45.?-1.:0.)
float mtf_hs = (h4_c>h4_20?1.:-1.) + (h4_20>h4_50?1.:-1.) + (h4_rs>55.?1.:h4_rs<45.?-1.:0.)
// micro TF (5m) — ใช้เมื่อดูกราฟ ≤1H เพื่อจับจังหวะละเอียด
m5_c   = request.security(syminfo.tickerid, "5", close,            lookahead=barmerge.lookahead_off)
m5_e20 = request.security(syminfo.tickerid, "5", ta.ema(close,20), lookahead=barmerge.lookahead_off)
m5_rsx = request.security(syminfo.tickerid, "5", ta.rsi(close,14), lookahead=barmerge.lookahead_off)
float mtf_s5 = (m5_c>m5_e20?1.:-1.) + (m5_rsx>55.?1.:m5_rsx<45.?-1.:0.)
float mtf_raw = mtf_ws + mtf_ds + mtf_hs + (use_m5?mtf_s5:0.)
float mtf_sc  = f_clamp(mtf_raw / (use_m5?11.:9.) * 100., -100., 100.)
bool  mtf_flag= math.abs(mtf_sc) < 30.
bool  w_bull  = mtf_ws >= 2.
bool  w_bear  = mtf_ws <= -2.
string mtf_str = mtf_sc>=60.?"BULL 3/3":mtf_sc>=30.?"BULL 2/3":mtf_sc<=-60.?"BEAR 3/3":mtf_sc<=-30.?"BEAR 2/3":"MIXED"

// ══════════════════════════════════════════════════════════════
// §7 MOMENTUM ENGINE — 4-phase (simplified from 6, clearer signals)
// ══════════════════════════════════════════════════════════════
float rs       = rsi_v - rsi_v[3]
float ra       = rs - (rsi_v[3] - rsi_v[6])
float rsi_mom  = f_clamp(rs * 2.5, -25., 25.)
float mv       = mh - mh[2]
float ma_c     = mv - (mh[2] - mh[4])
float macd_mom = f_clamp(mv * 3., -20., 20.)
float vwp_mom  = f_clamp(close>0?(close-close[5])/close[5]*vol_r*100.*1.5:0., -20., 20.)
float cvd_mom  = f_clamp(cvd_sl / math.max(vol_ma,1.) * 30., -15., 15.)
float st_mom   = f_clamp((stoch_v-50.) * 0.4, -20., 20.)
float roc_mom  = f_clamp((roc5-roc5[3]) * 1.5, -10., 10.)
float mom_sc   = f_clamp((rsi_mom+macd_mom+vwp_mom+cvd_mom+st_mom+roc_mom) / 90. * 100., -100., 100.)
float mom_ac   = f_clamp(ra*0.3 + ma_c*2. + (roc5-roc5[3])*0.5, -10., 10.)

// ── MOMENTUM CYCLE — 6-phase state machine (strength + direction + acceleration) ──
// แนวคิด: รู้ว่าแรงอยู่จุดไหนของ cycle — ก่อตัว → เร่ง → พีค → แผ่ว → หมดแรง → กลับตัว
float mom_str   = math.abs(mom_sc)                                  // ความแข็งแกร่ง 0-100
float mom_slope = ta.ema(mom_sc - mom_sc[2], 3)                     // ทิศทางแรง (smoothed)
bool  mom_rising  = mom_slope > 0.5
bool  mom_falling = mom_slope < -0.5

// Phase 1 IGNITION 🔥 — แรงเพิ่งก่อตัว: score ยังต่ำแต่ slope+accel พุ่งทางเดียวกัน (เตือนล่วงหน้า)
bool mom_ignite_L = mom_sc > -10. and mom_sc < 30. and mom_slope > 1.5 and mom_ac > 0.5 and cvd_bull
bool mom_ignite_S = mom_sc <  10. and mom_sc > -30. and mom_slope < -1.5 and mom_ac < -0.5 and cvd_bear
bool mom_ignite   = mom_ignite_L or mom_ignite_S
// Phase 2 BUILDING ⚡ — แรงกำลังสะสม: 30-55 และยังเพิ่ม
bool mom_build  = mom_str >= 25. and mom_str < 55. and ((mom_sc>0 and mom_rising) or (mom_sc<0 and mom_falling)) and mom_ac * math.sign(mom_sc) > 0.
// Phase 3 ACCELERATION 🚀 — แรงเต็มสปีด: >55 และยังเร่งต่อ
bool mom_accel  = mom_str >= 55. and ((mom_sc>0 and mom_rising) or (mom_sc<0 and mom_falling)) and mom_ac * math.sign(mom_sc) >= 0.
// Phase 4 PEAK ⚠️ — แรงสุดแต่ accel ติดลบ = ใกล้หมด
bool mom_peak   = mom_str > 55. and mom_ac * math.sign(mom_sc) < -0.3
// Phase 5 FADING ↘ — แรงถอย: score ลดจากโซนสูง + MACD hist อ่อนลง
bool mom_fade   = mom_sc > 40. and mom_falling and mh < mh[1]
bool mom_fade_S = mom_sc < -40. and mom_rising and mh > mh[1]
// Phase 6 REVERSAL ↩ — สุดทางแล้วเด้งกลับ: extreme + slope พลิกทาง + volume ยืนยัน
bool mom_revbot = mom_sc < -45. and mom_slope > 0.5 and mom_ac > 0.5 and (cvd_bull or vol_anom_bull)
bool mom_revtop = mom_sc >  45. and mom_slope < -0.5 and mom_ac < -0.5 and (cvd_bear or vol_anom_bear)

string mom_phase = mom_revbot?"REV-BOT ↩":mom_revtop?"REV-TOP ↩":mom_peak?"PEAK ⚠️":(mom_fade or mom_fade_S)?"FADING ↘":mom_accel?"ACCEL 🚀":mom_build?"BUILD ⚡":mom_ignite?"IGNITE 🔥":"NEUTRAL"

// Early warning — รู้ทันก่อน signal จริง: cycle เปลี่ยนเฟสสำคัญ
bool early_bull = (mom_ignite_L or mom_revbot) and not (mom_ignite_L[1] or mom_revbot[1])
bool early_bear = (mom_ignite_S or mom_revtop or mom_peak) and not (mom_ignite_S[1] or mom_revtop[1] or mom_peak[1])

// ══════════════════════════════════════════════════════════════
// §8 TREND ENGINE — ATR-normalized stage
// ══════════════════════════════════════════════════════════════
float ma_al = ((close>ma1?1.:0.)+(close>ma2?1.:0.)+(close>ma3?1.:0.)+(close>ma4?1.:0.)+(ma1>ma2?1.:0.)+(ma2>ma3?1.:0.)+(ma3>ma4?1.:0.)) - ((close<ma1?1.:0.)+(close<ma2?1.:0.)+(close<ma3?1.:0.)+(close<ma4?1.:0.)+(ma1<ma2?1.:0.)+(ma2<ma3?1.:0.)+(ma3<ma4?1.:0.))
float adx_dir  = adx_v>=25.?(dip>dim?30.:-10.):adx_v>=15.?(dip>dim?10.:-5.):(dip>dim?3.:-3.)
float dist_sc  = ma2 > 0 ? f_clamp((close-ma2)/ma2*200., -15., 15.) : 0.
bool  hh = high > ta.highest(high,i_swing)[1]
bool  hl = low  > ta.lowest(low,  i_swing)[1]
bool  lh = high < ta.highest(high,i_swing)[1]
bool  ll = low  < ta.lowest(low,  i_swing)[1]
float st_sc = (hh?10.:0.)+(hl?10.:0.)-(lh?10.:0.)-(ll?10.:0.)
float tr_sc = f_clamp(ma_al/7.*40. + adx_dir + dist_sc + st_sc, -100., 100.)

// [F5] ATR-normalized stage — same thresholds work for BTC, ETF, single stock
// Original: fixed % = wrong for crypto (BTC moves 8% in hours, ETF doesn't)
float dist_atr = atr_v > 0 ? (close - ma2) / atr_v : 0.
bool adx_rising = adx_v > adx_v[3]

// Stage: 1=Accum, 2=Markup, 3=Extended, 4=Distribution (ATR-normalized)
int mkt_stage = math.abs(dist_atr)<1.0 and adx_v<15.?1: dist_atr>4.0 and (rsi_v>70. or mom_fade or vol_anom_bear)?4: adx_v>=15. and close>ma2 and hma_up?2: dist_atr>3.0 and rsi_v>60.?3:0
string stage_s = mkt_stage==1?"S1:Accum":mkt_stage==2?"S2:Markup":mkt_stage==3?"S3:Extended":mkt_stage==4?"S4:Dist":"S0:Watch"

bool tm_bear_ok = tr_sc > 30. and mom_sc < mom_sc[3] and mom_ac < -0.5 and rsi_v > 60.
bool tm_bull_ok = tr_sc < -30. and mom_sc > mom_sc[3] and mom_ac > 0.5  and rsi_v < 40.

// ══════════════════════════════════════════════════════════════
// §9 DIVERGENCE — pivot-anchored (not fixed 5-bar)
// ══════════════════════════════════════════════════════════════
// [F6] Use confirmed pivot highs/lows as anchors
// Original bug: low < low[5] — fixed 5-bar offset fires on noise in trends
float piv_lo = ta.pivotlow(low,  i_swing, i_swing)
float piv_hi = ta.pivothigh(high, i_swing, i_swing)

var float last_plo = na
var float prev_plo = na
var float last_plr = na
var float prev_plr = na
var float last_phi = na
var float prev_phi = na
var float last_phr = na
var int  last_plo_bar = 0
var int  last_phi_bar = 0
var float prev_phr = na

if not na(piv_lo)
    prev_plo := last_plo
    prev_plr := last_plr
    last_plo := piv_lo
    last_plr := rsi_v[i_swing]
    last_plo_bar := bar_index - i_swing
if not na(piv_hi)
    prev_phi := last_phi
    prev_phr := last_phr
    last_phi := piv_hi
    last_phr := rsi_v[i_swing]
    last_phi_bar := bar_index - i_swing

bool bull_div  = not na(last_plo) and not na(prev_plo) and last_plo < prev_plo and last_plr > prev_plr
bool bear_div  = not na(last_phi) and not na(prev_phi) and last_phi > prev_phi and last_phr < prev_phr
bool h_bull_div= low  > low[5]  and rsi_v < rsi_v[5] and ms_trend == 1
bool h_bear_div= high < high[5] and rsi_v > rsi_v[5] and ms_trend == -1

// [F17] เดิมยิง label ทุกแท่งที่ div ค้าง true → กองทับเป็นปื้น | ใหม่: ยิงครั้งเดียวตอน div เกิด + กรอง RSI extreme
bool bull_div_new = bull_div and not bull_div[1] and last_plr < 45.
bool bear_div_new = bear_div and not bear_div[1] and last_phr > 55.
if i_div and bull_div_new
    label.new(bar_index-i_swing, last_plo-atr_v*0.8, "📐+", color=color.new(color.lime,20), textcolor=color.white, style=label.style_label_up, size=size.tiny, force_overlay=true)
if i_div and bear_div_new
    label.new(bar_index-i_swing, last_phi+atr_v*0.8, "📐-", color=color.new(color.red,20), textcolor=color.white, style=label.style_label_down, size=size.tiny, force_overlay=true)

// ══════════════════════════════════════════════════════════════
// §9B ELLIOTT WAVE HEURISTIC — นับคลื่นจากโครงสร้าง pivot + ลายเซ็น momentum
// ══════════════════════════════════════════════════════════════
bool _hh = not na(last_phi) and not na(prev_phi) and last_phi>prev_phi
bool _hl = not na(last_plo) and not na(prev_plo) and last_plo>prev_plo
bool _lh = not na(last_phi) and not na(prev_phi) and last_phi<prev_phi
bool _ll = not na(last_plo) and not na(prev_plo) and last_plo<prev_plo
var int ew_dir = 0
var int ew_run = 0
bool _newp = not na(piv_lo) or not na(piv_hi)
if _newp and ((_hh and _hl) or (not na(piv_hi) and _hh) or (not na(piv_lo) and _hl))
    ew_run := ew_dir==1?math.min(ew_run+1,9):1
    ew_dir := 1
else if _newp and ((_lh and _ll) or (not na(piv_hi) and _lh) or (not na(piv_lo) and _ll))
    ew_run := ew_dir==-1?math.min(ew_run+1,9):1
    ew_dir := -1
int  ew_wave = math.min(ew_run, 5)
// ลายเซ็น: คลื่น 3 = momentum แรงสุด | คลื่น 5 = ราคาทำ extreme ใหม่แต่ momentum divergence → ใกล้กลับตัว
bool ew_w3 = ew_wave==3 and (mom_accel or mom_build)
bool ew_w5 = ew_wave>=5 and ((ew_dir==1 and bear_div) or (ew_dir==-1 and bull_div))
string ew_s = ew_dir==0?"":(" W"+str.tostring(ew_wave)+(ew_dir==1?"↑":"↓")+(ew_w5?"⚠":ew_w3?"⚡":""))

// ══════════════════════════════════════════════════════════════
// §9C ADAPTIVE FIBONACCI CORE — structure-qualified swing leg
// Only trusts a leg when its range is meaningful versus ATR and direction agrees with structure/momentum.
// ══════════════════════════════════════════════════════════════
bool  fib_ok0  = not na(last_phi) and not na(last_plo) and last_phi>last_plo
bool  fib_dn   = fib_ok0 and last_plo_bar > last_phi_bar
float fib_rng  = fib_ok0?last_phi-last_plo:na
float fib_leg_atr = fib_ok0 and atr_v>0 ? fib_rng/atr_v : 0.
bool  fib_struct_ok = fib_ok0 and ((fib_dn and (ms_trend<=0 or _lh or _ll)) or (not fib_dn and (ms_trend>=0 or _hh or _hl)))
bool  fib_mom_ok = fib_ok0 and ((fib_dn and mom_sc<25.) or (not fib_dn and mom_sc>-25.))
bool  fib_ok = fib_ok0 and fib_leg_atr>=1.25 and (fib_struct_ok or fib_mom_ok)
float fib_pct  = fib_ok?(fib_dn?(close-last_plo)/fib_rng:(last_phi-close)/fib_rng):na
f_lvl(float r) => fib_dn ? last_plo+fib_rng*r : last_phi-fib_rng*r
string fib_zone = not fib_ok?"─":fib_pct<0.?"EXT":fib_pct<0.382?"SHALLOW":fib_pct<0.618?"VALUE":fib_pct<0.786?"DEEP":fib_pct<=1.?"INVALIDATION":"EXT"
// Extension is regime aware: strong trend seeks 1.618, normal continuation 1.272, exhaustion retraces instead.
float fib_ext  = ew_w5?0.0:(mom_accel and adx_v>=22.)?0.618:(mom_build or adx_v>=18.)?0.272:0.0
bool  fib_cont = fib_ok and not ew_w5 and ((fib_dn and mom_sc<0. and mtf_sc<=30.) or (not fib_dn and mom_sc>0. and mtf_sc>=-30.))
float fib_tgt  = not fib_ok?na:fib_cont?(fib_dn?last_plo-fib_rng*fib_ext:last_phi+fib_rng*fib_ext):(fib_pct<0.382?f_lvl(0.382):fib_pct<0.5?f_lvl(0.5):fib_pct<0.618?f_lvl(0.618):f_lvl(0.786))
float fib_quality = fib_ok ? f_clamp(45. + math.min(fib_leg_atr,4.)*7. + (fib_struct_ok?15.:0.) + (fib_mom_ok?8.:0.) + (adx_v>=18.?8.:0.), 0., 100.) : 0.

// ══════════════════════════════════════════════════════════════
// §9D ADAPTIVE SUPPORT / RESISTANCE — structure zones, not pivot clutter
// Confirmed pivots are clustered by ATR. Repeated reactions increase strength.
// Only the best nearby 1-3 support and resistance zones are drawn.
// ══════════════════════════════════════════════════════════════
var array<float> sr_levels = array.new_float()
var array<float> sr_scores = array.new_float()
var array<int>   sr_hits   = array.new_int()

f_sr_add(float sr_in_level, float baseScore, float tol) =>
    if not na(sr_in_level)
        bool merged=false
        int n=array.size(sr_levels)
        if n>0
            for k=0 to n-1
                float old=array.get(sr_levels,k)
                if math.abs(old-sr_in_level)<=tol
                    int hits=array.get(sr_hits,k)+1
                    float nw=(old*(hits-1)+sr_in_level)/hits
                    float sr_merge_score=math.min(100.,array.get(sr_scores,k)+8.+baseScore*0.10)
                    array.set(sr_levels,k,nw)
                    array.set(sr_scores,k,sr_merge_score)
                    array.set(sr_hits,k,hits)
                    merged:=true
                    break
        if not merged
            array.push(sr_levels,sr_in_level)
            array.push(sr_scores,math.min(100.,baseScore))
            array.push(sr_hits,1)
        // Keep memory bounded. Old/weakest zones are less useful than recent confirmed structure.
        if array.size(sr_levels)>18
            int weak=0
            float weakSc=array.get(sr_scores,0)
            for j=1 to array.size(sr_scores)-1
                if array.get(sr_scores,j)<weakSc
                    weakSc:=array.get(sr_scores,j)
                    weak:=j
            array.remove(sr_levels,weak)
            array.remove(sr_scores,weak)
            array.remove(sr_hits,weak)

float sr_tol=math.max(atr_v*i_sr_atr,syminfo.mintick*8)
if not na(piv_lo)
    float pvVol=nz(vol_r[i_swing],1.)
    float pvRng=math.max(high[i_swing]-low[i_swing],syminfo.mintick)
    float pvWick=(math.min(open[i_swing],close[i_swing])-low[i_swing])/pvRng
    float pvScore=45.+math.min(pvVol,2.5)*10.+pvWick*20.+(_hl?8.:0.)
    f_sr_add(piv_lo,pvScore,sr_tol)
if not na(piv_hi)
    float pvVolH=nz(vol_r[i_swing],1.)
    float pvRngH=math.max(high[i_swing]-low[i_swing],syminfo.mintick)
    float pvWickH=(high[i_swing]-math.max(open[i_swing],close[i_swing]))/pvRngH
    float pvScoreH=45.+math.min(pvVolH,2.5)*10.+pvWickH*20.+(_lh?8.:0.)
    f_sr_add(piv_hi,pvScoreH,sr_tol)

// HTF extremes add structural importance, but are clustered into existing zones.
if i_sr_htf and barstate.isconfirmed
    bool newHtfHi=h4_hi!=h4_hi[1]
    bool newHtfLo=h4_lo!=h4_lo[1]
    if newHtfHi
        f_sr_add(h4_hi,72.,math.max(sr_tol,h4_at*0.18))
    if newHtfLo
        f_sr_add(h4_lo,72.,math.max(sr_tol,h4_at*0.18))

// Broken resistance can flip to support and vice versa: reward zones that survive a retest.
if barstate.isconfirmed and array.size(sr_levels)>0
    for k=0 to array.size(sr_levels)-1
        float sr_touch_level=array.get(sr_levels,k)
        float sr_touch_dist=math.abs(close-sr_touch_level)
        if sr_touch_dist<=sr_tol and ((close>sr_touch_level and low<=sr_touch_level) or (close<sr_touch_level and high>=sr_touch_level))
            array.set(sr_scores,k,math.min(100.,array.get(sr_scores,k)+2.5))

var array<line> sr_lines=array.new_line()
var array<box>  sr_boxes=array.new_box()
var array<label> sr_labels=array.new_label()
if barstate.islast
    while array.size(sr_lines)>0
        line.delete(array.pop(sr_lines))
    while array.size(sr_boxes)>0
        box.delete(array.pop(sr_boxes))
    while array.size(sr_labels)>0
        label.delete(array.pop(sr_labels))
    if i_sr and array.size(sr_levels)>0
        // Find best levels separately above/below price using strength minus distance penalty.
        array<float> usedSup=array.new_float()
        array<float> usedRes=array.new_float()
        for slot=0 to i_sr_n-1
            int bestS=-1
            int bestR=-1
            float rankS=-1e9
            float rankR=-1e9
            for k=0 to array.size(sr_levels)-1
                float sr_level_k=array.get(sr_levels,k)
                float sr_score_k=array.get(sr_scores,k)
                float distA=atr_v>0?math.abs(close-sr_level_k)/atr_v:99.
                float rk=sr_score_k-distA*2.2
                bool alreadyS=array.includes(usedSup,sr_level_k)
                bool alreadyR=array.includes(usedRes,sr_level_k)
                if sr_level_k<=close and sr_score_k>=i_sr_min and not alreadyS and rk>rankS
                    rankS:=rk
                    bestS:=k
                if sr_level_k>close and sr_score_k>=i_sr_min and not alreadyR and rk>rankR
                    rankR:=rk
                    bestR:=k
            if bestS>=0
                float lvS=array.get(sr_levels,bestS)
                float scS=array.get(sr_scores,bestS)
                array.push(usedSup,lvS)
                color cS=slot==0?color.new(color.lime,10):color.new(color.teal,25)
                array.push(sr_boxes,box.new(bar_index-60,lvS+sr_tol,bar_index+25,lvS-sr_tol,border_color=color.new(cS,65),bgcolor=color.new(cS,92),force_overlay=true))
                array.push(sr_lines,line.new(bar_index-60,lvS,bar_index+25,lvS,color=cS,width=slot==0?2:1,force_overlay=true))
                array.push(sr_labels,label.new(bar_index+25,lvS,"S"+str.tostring(slot+1)+"  "+str.tostring(lvS,"#.########")+"  "+str.tostring(math.round(scS),"#")+"%",style=label.style_label_left,color=color.new(color.black,100),textcolor=cS,size=size.tiny,force_overlay=true))
            if bestR>=0
                float lvR=array.get(sr_levels,bestR)
                float scR=array.get(sr_scores,bestR)
                array.push(usedRes,lvR)
                color cR=slot==0?color.new(color.red,10):color.new(color.orange,25)
                array.push(sr_boxes,box.new(bar_index-60,lvR+sr_tol,bar_index+25,lvR-sr_tol,border_color=color.new(cR,65),bgcolor=color.new(cR,92),force_overlay=true))
                array.push(sr_lines,line.new(bar_index-60,lvR,bar_index+25,lvR,color=cR,width=slot==0?2:1,force_overlay=true))
                array.push(sr_labels,label.new(bar_index+25,lvR,"R"+str.tostring(slot+1)+"  "+str.tostring(lvR,"#.########")+"  "+str.tostring(math.round(scR),"#")+"%",style=label.style_label_left,color=color.new(color.black,100),textcolor=cR,size=size.tiny,force_overlay=true))

// ══════════════════════════════════════════════════════════════
// §10 VOLUME FLOW
// ══════════════════════════════════════════════════════════════
// [F13] Adaptive VFI length: 4H chart = 50 bars, Daily = 100 bars, Intraday = 30 bars
// Original: fixed 130 bars = 21 days on 4H, VFI barely reacted to CPI/Fed
int vfi_len = timeframe.in_seconds()<=900?20:timeframe.in_seconds()<=3600?30:timeframe.in_seconds()<=14400?50:100
float vfi_typ  = hlc3
float vfi_it   = math.log(vfi_typ) - math.log(nz(vfi_typ[1], vfi_typ))
float vfi_vi   = ta.stdev(vfi_it, 30)
float vfi_cut  = 0.2 * vfi_vi * close
float vfi_vav  = ta.sma(volume, vfi_len)
float vfi_va   = math.min(volume, vfi_vav * 2.)
float vfi_mf   = vfi_typ - nz(vfi_typ[1], vfi_typ)
float vfi_fl   = vfi_mf > vfi_cut ? vfi_va : vfi_mf < -vfi_cut ? -vfi_va : 0.
float vfi_raw  = math.sum(vfi_fl, vfi_len) / math.max(vfi_vav, 1.)
float vfi_s    = ta.ema(vfi_raw, 3)
float vfi_hi_  = ta.highest(vfi_s, 100)
float vfi_lo_  = ta.lowest(vfi_s,  100)
float vfi_norm = vfi_hi_ != vfi_lo_ ? f_clamp((vfi_s-vfi_lo_)/(vfi_hi_-vfi_lo_)*100., 0., 100.) : 50.

float obv_raw  = ta.obv
float obv_mn   = ta.sma(obv_raw, 20)
float obv_sd   = ta.stdev(obv_raw, 20)
float obv_z    = obv_sd > 0 ? (obv_raw-obv_mn)/obv_sd : 0.
float obv_norm = f_clamp((obv_z+3.)/6.*100., 0., 100.)
bool  obv_up   = ta.ema(ta.change(obv_raw,3), 5) > 0

float mh_hi   = ta.highest(mh, 100)
float mh_lo   = ta.lowest(mh,  100)
float macd_nm = mh_hi != mh_lo ? (mh-mh_lo)/(mh_hi-mh_lo)*100. : 50.

// ══════════════════════════════════════════════════════════════
// §11 DWCS v6 — stable weights + RSI sentiment fix
// ══════════════════════════════════════════════════════════════

// [F7] RSI Sentiment transform — parabolic (original: raw RSI inverted at extremes)
// Bug: RSI=85 → sent_rsi=85 = "Super Bullish" but RSI 85 = reversal risk
// Fix: oversold (RSI<30) = high bullish; overbought (RSI>70) = moderate (caution)
f_rsi_sent(r) =>
    r <= 30 ? f_clamp(80. - r, 50., 100.) : r >= 70 ? f_clamp(120. - r, 30., 65.) : r

float sent_rsi  = f_rsi_sent(rsi_v)
float sent_macd = macd_nm
float sent_vfi  = vfi_norm
float sent_obv  = obv_norm
float sent_adx  = adx_v>=25. and dip>dim ? f_clamp(50.+adx_v*0.5,50.,100.) : adx_v>=25. and dip<dim ? f_clamp(50.-adx_v*0.5,0.,50.) : 50.
float sent_raw  = sent_rsi*0.25 + sent_macd*0.20 + sent_vfi*0.25 + sent_obv*0.15 + sent_adx*0.15
float sent_sc   = f_clamp(ta.ema(sent_raw, 4), 0., 100.)

// WaveTrend
float wt_ap  = hlc3
float wt_esa = ta.ema(wt_ap, 10)
float wt_d   = ta.ema(math.abs(wt_ap-wt_esa), 10)
float wt_ci  = (wt_ap-wt_esa) / (0.015*math.max(wt_d, syminfo.mintick))
float wt1    = ta.ema(wt_ci, 21)
float wt2    = ta.sma(wt1, 4)
float wt_diff = wt1 - wt2
float wt1s   = f_clamp((wt1+100.)/2., 0., 100.)
var int wt_last = 0
var int wt_age  = 0
// [F9] WT in ranging: use extreme zones when ADX < 20 (original: completely suppressed)
bool wt_trend_ok = adx_v >= 20.
bool wt_range_ok = adx_v < 20.
bool wt_buy  = (ta.crossover(wt_diff,  5.) and wt_trend_ok) or (wt_range_ok and ta.crossover(wt1, -40.))
bool wt_sell = (ta.crossunder(wt_diff, -5.) and wt_trend_ok) or (wt_range_ok and ta.crossunder(wt1, 40.))
if wt_buy
    wt_last := 1
    wt_age := 0
else if wt_sell
    wt_last := -1
    wt_age := 0
else
    wt_age := wt_age + 1
    if wt_age >= 50
        wt_last := 0
float wt_dk  = wt_last==0?0.:math.max(0.,1.-float(wt_age)/50.)
float wt_lyr = wt1s * wt_dk

// CPK momentum
float cpk_raw = ta.wma(ta.roc(close,14)+ta.roc(close,11), 10)
float cpk_hi = ta.highest(cpk_raw, 200)
float cpk_lo = ta.lowest(cpk_raw,  200)
float cpk    = cpk_hi != cpk_lo ? (cpk_raw-cpk_lo)/(cpk_hi-cpk_lo)*100. : 50.

// Chips — [F10] Removed +25 hardcoded floor from profit_chips
float lo_Nr = ta.lowest(low,  100)
float hi_Nr = ta.highest(high, 100)
float rng_Nr = math.max(hi_Nr - lo_Nr, syminfo.mintick)
// [F10] profit_chips: was clamp(... + 25, 0, 100) — floor 25 hid bearish signal
float profit_chips = f_clamp((close*0.96 - lo_Nr) / rng_Nr * 100., 0., 100.)
float lc_chips     = f_clamp(100. - (close*1.04 - lo_Nr) / rng_Nr * 100., 0., 100.)

// Behavior patterns
bool pump_dump  = vol_surge and close<open and high>ta.highest(high,20)[1] and profit_chips>60.
bool capitul    = vol_r>3.0 and close<open and close<ta.lowest(close,10)[1]
bool whale_dist = vol_r>3.0 and math.abs(ta.change(close,1))<atr_v*0.1 and profit_chips>60.
bool blowoff    = rsi_v>78. and close>open and vol_r<0.9 and profit_chips>80.
bool accum_sig  = profit_chips<35. and lc_chips>=20. and hma_up

float l_beh = pump_dump?15.:blowoff?18.:whale_dist?25.:accum_sig?65.:capitul?35.:50.
float l_trap= pump_dump?12.:whale_dist?25.:blowoff?18.:capitul?40.:50.

// MTF contribution to DWCS (no extra security calls — reuse mtf_sc)
float l_mtf = mtf_sc >= 0 ? f_clamp(50.+mtf_sc*0.5,50.,100.) : f_clamp(50.+mtf_sc*0.5,0.,50.)

// [F8] DWCS stable fixed weights — no trend_strength modulation
// Original bug: weights shifted with ADX, so DWCS=65 meant different things in trend vs range
// Fix: constant weights → threshold 60/40 is consistent across all regimes
// Weights: Sentiment 30, VFI 20, CPK 12, Behavior 15, Trap 10, WT 8, MTF 5
float dwcs_raw = sent_sc*0.30 + vfi_norm*0.20 + cpk*0.12 + l_beh*0.15 + l_trap*0.10 + wt_lyr*0.08 + l_mtf*0.05
float dwcs     = f_clamp(ta.ema(dwcs_raw, 5), 0., 100.)

// ══════════════════════════════════════════════════════════════
// §12 SCENARIO ENGINE — documented priority
// ══════════════════════════════════════════════════════════════
// [F11] SMC now feeds scenario: pa_bull_sc/pa_bear_sc connected to BOS/Sweep
// Original bug: both always = 0 (declared but never updated)
int pa_bull = ms_trend==1 and bos_bull?2:bull_sw?1:0
int pa_bear = ms_trend==-1 and bos_bear?2:bear_sw?1:0

// Priority order (documented):
// P1 Extreme/Trap → P2 Smart Money → P3 Structural → P4 Directional → P5 Default
string scenario = "NEUTRAL"
if pump_dump                                                          // P1: Trap
    scenario := "PUMP-DUMP 🚨"
else if blowoff                                                       // P1: Trap
    scenario := "BLOWOFF TOP 🚨"
else if whale_dist                                                    // P2: Institutional
    scenario := "WHALE DIST ⚠️"
else if capitul                                                       // P2: Extreme
    scenario := "CAPITULATION 🔻"
else if ms_trend==1 and bos_bull and cvd_bull and vol_r>1.5           // P3: Smart Money Long
    scenario := "SMART MONEY LONG 💎"
else if ms_trend==-1 and bos_bear and cvd_bear and vol_r>1.5         // P3: Smart Money Short
    scenario := "SMART MONEY SHORT 💎"
else if dwcs>=65. and sent_sc>=60. and mtf_sc>=30.                   // P4: Strong bull
    scenario := "STRONG BULL ▲"
else if accum_sig and mtf_sc>=0. and obv_up                          // P4: Accumulation
    scenario := "ACCUMULATION 📦"
else if mkt_stage==2 and mom_build and ms_trend==1                   // P4: Markup
    scenario := "MARKUP ⚡"
else if tm_bull_ok                                                    // P4: Reversal
    scenario := "BULL REVERSAL ↗"
else if tm_bear_ok
    scenario := "BEAR REVERSAL ↘"
else if dwcs<=35. and sent_sc<=40. and mtf_sc<=-30.                  // P4: Strong bear
    scenario := "STRONG BEAR ▼"
else if mkt_stage==4                                                  // P4: Distribution
    scenario := "DISTRIBUTION 📤"
else if math.abs(mtf_sc)<30. and adx_v<20.                           // P5: Default
    scenario := "RANGING ─"

// ══════════════════════════════════════════════════════════════
// §13 MULTI-TF ENTRY ENGINE
// ══════════════════════════════════════════════════════════════
m15_c  = request.security(syminfo.tickerid, e_lo, close,           lookahead=barmerge.lookahead_off)
m15_e9 = request.security(syminfo.tickerid, e_lo, ta.ema(close,9), lookahead=barmerge.lookahead_off)
m15_21 = request.security(syminfo.tickerid, e_lo, ta.ema(close,21),lookahead=barmerge.lookahead_off)
m15_rs = request.security(syminfo.tickerid, e_lo, ta.rsi(close,14),lookahead=barmerge.lookahead_off)
m15_mh = request.security(syminfo.tickerid, e_lo, f_macdh(),        lookahead=barmerge.lookahead_off)
m15_at = request.security(syminfo.tickerid, e_lo, ta.atr(14),       lookahead=barmerge.lookahead_off)
m15_vr = request.security(syminfo.tickerid, e_lo, f_vr(),           lookahead=barmerge.lookahead_off)
h1_c   = request.security(syminfo.tickerid, e_mid, close,            lookahead=barmerge.lookahead_off)
h1_e20 = request.security(syminfo.tickerid, e_mid, ta.ema(close,20), lookahead=barmerge.lookahead_off)
h1_e50 = request.security(syminfo.tickerid, e_mid, ta.ema(close,50), lookahead=barmerge.lookahead_off)
h1_rs  = request.security(syminfo.tickerid, e_mid, ta.rsi(close,14), lookahead=barmerge.lookahead_off)
h1_mh  = request.security(syminfo.tickerid, e_mid, f_macdh(),         lookahead=barmerge.lookahead_off)
h1_vr  = request.security(syminfo.tickerid, e_mid, f_vr(),            lookahead=barmerge.lookahead_off)
h4_rs2 = request.security(syminfo.tickerid, e_hi,ta.rsi(close,14),  lookahead=barmerge.lookahead_off)
h4_mh2 = request.security(syminfo.tickerid, e_hi,f_macdh(),          lookahead=barmerge.lookahead_off)
h4_vr2 = request.security(syminfo.tickerid, e_hi,f_vr(),             lookahead=barmerge.lookahead_off)
bool use_d = i_tfc == "15m+1H+4H+D"
d_rs2  = request.security(syminfo.tickerid, e_dtf,ta.rsi(close,14),  lookahead=barmerge.lookahead_off)
bool d_bull = d_c>d_e20 and d_e20>d_e50
bool d_bear = d_c<d_e20 and d_e20<d_e50

float sc15 = (m15_c>m15_e9 and m15_e9>m15_21?2.:m15_c<m15_e9 and m15_e9<m15_21?-2.:0.) + (m15_rs>55.?1.5:m15_rs<45.?-1.5:0.) + (m15_mh>m15_mh[1]?1.5:-1.5) + (m15_vr>1.3?(m15_c>m15_e9?1.:-1.):0.)
float sc1h = (h1_c>h1_e20 and h1_e20>h1_e50?2.5:h1_c<h1_e20 and h1_e20<h1_e50?-2.5:h1_c>h1_e20?1.:-1.) + (h1_rs>55.?1.5:h1_rs<45.?-1.5:0.) + (h1_mh>0.?1.:-1.) + (h1_vr>1.3?(h1_c>h1_e20?1.:-1.):0.)
float sc4h = (mtf_hs>=2.?3.:mtf_hs<=-2.?-3.:mtf_hs*1.) + (h4_rs2>55.?1.5:h4_rs2<45.?-1.5:0.) + (h4_mh2>0.?1.:-1.) + (h4_vr2>1.3?(mtf_hs>=0.?1.:-1.):0.)
float scd  = use_d?((d_bull?2.:d_bear?-2.:0.)+(d_rs2>55.?1.:d_rs2<45.?-1.:0.)):0.
float w15=use_d?0.20:0.25
float w1h=use_d?0.30:0.35
float w4h=use_d?0.35:0.40
float wd=use_d?0.15:0.00
float sc_mx= use_d?(6.*w15+6.*w1h+6.*w4h+3.*wd):(6.*w15+6.*w1h+6.*w4h)
float esc  = sc_mx>0.?f_clamp((sc15*w15+sc1h*w1h+sc4h*w4h+scd*wd)/sc_mx*100.,-100.,100.):0.
bool  elong = esc>=30. and ms_trend>=0
bool  eshort= esc<=-30. and ms_trend<=0

// ══════════════════════════════════════════════════════════════
// §14 SIGNAL GATE
// ══════════════════════════════════════════════════════════════
float ec = 35.
ec += (math.abs(esc)>70.?22.:math.abs(esc)>50.?14.:math.abs(esc)>30.?7.:0.)
ec += ((elong and ms_trend==1) or (eshort and ms_trend==-1)?10.:0.)
ec += ((elong and mtf_sc>30.) or (eshort and mtf_sc<-30.)?10.:0.)
ec += ((elong and mtf_sc>60.) or (eshort and mtf_sc<-60.)?5.:0.)
ec += ((elong and bull_div) or (eshort and bear_div)?8.:0.)
ec += ((elong and h_bull_div) or (eshort and h_bear_div)?5.:0.)
ec += (h4_vr2>1.5 and ((elong and sc4h>0.) or (eshort and sc4h<0.))?8.:0.)
ec += ((elong and bos_bull) or (eshort and bos_bear)?8.:0.)         // confirmed BOS = higher weight
ec += ((elong and bull_sw) or (eshort and bear_sw)?8.:0.)
ec += ((elong and cvd_bull) or (eshort and cvd_bear)?6.:0.)
ec += ((elong and dwcs>60.) or (eshort and dwcs<40.)?8.:0.)         // DWCS confirmation
ec += ((elong and sent_sc>60.) or (eshort and sent_sc<40.)?5.:0.)
ec += (float(pa_bull)*4. * (elong?1.:0.))                           // [F11] SMC contributes
ec += (float(pa_bear)*4. * (eshort?1.:0.))
ec -= (mtf_flag?8.:0.)
ec -= ((elong and bear_div) or (eshort and bull_div)?12.:0.)
ec -= ((elong and h4_rs2>72.) or (eshort and h4_rs2<28.)?8.:0.)
ec -= ((elong and mom_peak) or (eshort and mom_peak)?10.:0.)
ec -= (mkt_stage==4?12.:0.)
ec += ((mkt_stage==2 and elong)?10.:0.)
ec += ((tm_bull_ok and elong)?12.:0.)
ec += ((tm_bear_ok and eshort)?12.:0.)
ec += ((elong and (mom_ignite_L or mom_build or mom_accel)) or (eshort and (mom_ignite_S or mom_build or mom_accel))?6.:0.)
ec -= ((elong and (mom_fade or mom_revtop)) or (eshort and (mom_fade_S or mom_revbot))?8.:0.)
float econf = f_clamp(ec, 10., 96.)

// R:R calculation
float sl_L  = h4_lo - h4_at*0.5
float sl_S  = h4_hi + h4_at*0.5
float rsk_L = math.max(math.abs(close-sl_L), atr_v*0.1)
float rsk_S = math.max(math.abs(close-sl_S), atr_v*0.1)
float swb_L = not na(sw_lo)?sw_lo:close-atr_v*3.
float swb_S = not na(sw_hi)?sw_hi:close+atr_v*3.
float swm_L = math.abs(close-swb_L)
float swm_S = math.abs(close-swb_S)
// [F16] Adaptive targets — ยืด/หดตามความแข็งของ momentum และ trend (ADX)
float tgt_k = f_clamp(1.0 + mom_str/100.*0.6 + (adx_v>25.?0.3:adx_v>18.?0.15:0.) + (mom_accel or mom_build?0.2:0.) - ((mom_fade or mom_fade_S or mom_peak)?0.35:0.), 0.7, 2.2)
// [F18] เดิม: เป้า = swing×multiplier ไม่จำกัดระยะ → บน TF ใหญ่ swing โต เป้าหลุดโลก (ทอง T1=3214!)
// ใหม่: จำกัดระยะ T1 ≤5×ATR, T2 ≤9×ATR + ถ้า fib target ใกล้กว่าและทิศเดียวกัน ใช้ fib (โครงสร้างจริง > สูตร)
float _d1L = swm_L>=atr_v*0.5?(swb_L+swm_L*i_ftp*tgt_k-close):atr_v*1.5*tgt_k
float _d1S = swm_S>=atr_v*0.5?(close-(swb_S-swm_S*i_ftp*tgt_k)):atr_v*1.5*tgt_k
float tp1_L = close + f_clamp(_d1L, atr_v*1.2, atr_v*5.0)
float tp1_S = close - f_clamp(_d1S, atr_v*1.2, atr_v*5.0)
float _d2L = (swb_L+swm_L*(mom_accel?2.618:2.0)*math.min(tgt_k,1.6))-close
float _d2S = close-(swb_S-swm_S*(mom_accel?2.618:2.0)*math.min(tgt_k,1.6))
float tp2_L = close + f_clamp(_d2L, atr_v*2.0, atr_v*9.0)
float tp2_S = close - f_clamp(_d2S, atr_v*2.0, atr_v*9.0)
tp1_L := not na(fib_tgt) and fib_tgt>close+atr_v*0.8 and fib_tgt<tp1_L ? fib_tgt : tp1_L
tp1_S := not na(fib_tgt) and fib_tgt<close-atr_v*0.8 and fib_tgt>tp1_S ? fib_tgt : tp1_S
float rr_L  = rsk_L>0.?math.abs(tp1_L-close)/rsk_L:0.
float rr_S  = rsk_S>0.?math.abs(tp1_S-close)/rsk_S:0.

bool _a3L = sc15>1. and sc1h>1. and sc4h>1.
bool _a3S = sc15<-1. and sc1h<-1. and sc4h<-1.
float _bod = (high-low)>0.?math.abs(close-open)/(high-low):0.
bool _revL = tm_bull_ok and bull_div and (bull_sw or cvd_bull)
bool _revS = tm_bear_ok and bear_div and (bear_sw or cvd_bear)
// [F15] Stricter gate: ห้าม long สวน MTF bear เต็มขั้ว / ต้องยืนเหนือ-ใต้ HMA / ห้ามเข้าตอน momentum แผ่ว
bool _preL = _a3L and (ms_trend==1 or _revL) and not mom_peak and not mom_fade and h4_rs2<75. and _bod>=0.30 and econf>=i_conf and mtf_sc>-50. and close>hma_v
bool _preS = _a3S and (ms_trend==-1 or _revS) and not mom_peak and not mom_fade_S and h4_rs2>25. and _bod>=0.30 and econf>=i_conf and mtf_sc<50. and close<hma_v

// [F14] Adaptive cooldown — ETF/daily traders need more space between signals
// Original: fixed 3 bars = 12h on 4H → too frequent for position trading
int cd_bars = timeframe.in_seconds()<=900?20:timeframe.in_seconds()<=3600?15:timeframe.in_seconds()<=14400?10:6
var int _cd = 0
_cd := math.max(0, _cd-1)
bool sig_long  = _preL and rr_L>=i_rr and _cd==0
bool sig_short = _preS and rr_S>=i_rr and _cd==0
if sig_long or sig_short
    _cd := cd_bars

// ══════════════════════════════════════════════════════════════
// §14B NEXT PIVOT PREDICTION — confluence model, not linear-regression alone
// Votes: MTF/trend, market structure, momentum, divergence, sweeps/rejection, volatility and mean-reversion risk.
// ══════════════════════════════════════════════════════════════
float _lr_now  = ta.linreg(close, 34, 0)
float _lr_prev = ta.linreg(close, 34, 1)
float np_slope = atr_v>0?(_lr_now-_lr_prev)/atr_v:0.
float np_vote = 0.
np_vote += mtf_sc*0.20
np_vote += tr_sc*0.18
np_vote += mom_sc*0.20
np_vote += (dwcs-50.)*0.28
np_vote += ms_trend==1?12.:ms_trend==-1?-12.:0.
np_vote += bos_bull?10.:bos_bear?-10.:0.
np_vote += bull_sw?8.:bear_sw?-8.:0.
np_vote += bull_div_new?8.:bear_div_new?-8.:0.
np_vote += np_slope*8.
np_vote -= (rsi_v>74.?8.:rsi_v<26.?-8.:0.)
float p_up = f_clamp(50.+np_vote*0.45, 5., 95.)
float np_conf = f_clamp(50. + math.abs(np_vote)*0.45 + (adx_v>=18.?8.:0.) + (math.abs(mtf_sc)>=30.?7.:0.) - (mtf_flag?10.:0.) - (mkt_stage==4?6.:0.), 25., 95.)
bool np_up = p_up>=50.
float np_amp = f_clamp(1.0 + math.abs(mom_sc)/100.*0.8 + (adx_v>=25.?0.5:adx_v>=18.?0.25:0.) + math.abs(np_slope)*0.25, 0.8, 2.8)
float np_raw = close + (np_up?1.:-1.)*atr_v*np_amp*math.sqrt(math.max(float(i_fcb),1.)/5.)
// Prefer a qualified structural/Fibonacci target when it is in the predicted direction and not absurdly far.
float np_target = np_raw
if fib_ok and fib_quality>=60. and not na(fib_tgt)
    if np_up and fib_tgt>close and fib_tgt<close+atr_v*6.
        np_target := fib_tgt
    if not np_up and fib_tgt<close and fib_tgt>close-atr_v*6.
        np_target := fib_tgt
var line  fc_base = na
var label fc_lb = na
if barstate.islast and i_fc
    int fx2 = bar_index + i_fcb
    line.delete(fc_base)
    label.delete(fc_lb)
    color npc = np_up?color.lime:color.red
    fc_base := line.new(bar_index, close, fx2, np_target, color=color.new(npc,20), width=2, style=line.style_dotted, force_overlay=true)
    string np_kind = np_up?"NEXT PIVOT HIGH":"NEXT PIVOT LOW"
    string np_txt = (np_up?"▲ ":"▼ ")+np_kind+"\n"+str.tostring(np_target,"#.##")+"  |  Conf "+str.tostring(math.round(np_conf),"#")+"%"
    fc_lb := label.new(fx2, np_target, np_txt, color=color.new(npc,82), textcolor=npc, style=label.style_label_left, size=size.small, force_overlay=true)

// ══════════════════════════════════════════════════════════════
// §14C ADAPTIVE FIBONACCI — clean key levels only
// Clean mode draws 38.2 / 50 / 61.8 / 78.6 + target; full mode adds 0/100 anchors.
// ══════════════════════════════════════════════════════════════
var array<line>  fib_ln = array.new<line>()
var array<label> fib_lb = array.new<label>()
if barstate.islast and i_fib
    while array.size(fib_ln) > 0
        line.delete(array.pop(fib_ln))
    while array.size(fib_lb) > 0
        label.delete(array.pop(fib_lb))
    if fib_ok and fib_quality>=50.
        int fxa = math.max(math.min(last_phi_bar,last_plo_bar), bar_index-250)
        int fxb = bar_index + 6
        float[] _rs = i_clean?array.from(0.382,0.5,0.618,0.786):array.from(0.0,0.236,0.382,0.5,0.618,0.786,1.0)
        for i = 0 to array.size(_rs)-1
            float r = array.get(_rs,i)
            float y = f_lvl(r)
            bool key = r==0.5 or r==0.618
            color cl = r==0.618?cFibKey:key?color.new(color.yellow,35):color.new(color.gray,72)
            array.push(fib_ln,line.new(fxa,y,fxb,y,color=cl,width=key?2:1,force_overlay=true))
            if key or not i_clean
                array.push(fib_lb,label.new(fxb,y,str.tostring(r*100.,"#.#")+"%",color=color.new(color.black,100),textcolor=cl,style=label.style_label_left,size=size.tiny,force_overlay=true))
        if not na(fib_tgt)
            array.push(fib_ln,line.new(bar_index,fib_tgt,fxb,fib_tgt,color=cFibTgt,width=2,style=line.style_dashed,force_overlay=true))
            array.push(fib_lb,label.new(fxb,fib_tgt,"Fib target · Q"+str.tostring(math.round(fib_quality),"#"),color=color.new(color.black,100),textcolor=cFibTgt,style=label.style_label_left,size=size.tiny,force_overlay=true))

// ══════════════════════════════════════════════════════════════
// §15 PLOTSHAPES
// ══════════════════════════════════════════════════════════════
plotshape(sig_long,  "Long ▲",  shape.triangleup,   location.belowbar, color.new(color.lime,0),  size=size.normal, force_overlay=true)
plotshape(sig_short, "Short ▼", shape.triangledown, location.abovebar, color.new(color.red,0),   size=size.normal, force_overlay=true)
// bgcolor ไม่รองรับ force_overlay — ใช้ plotshape บอก signal แทน

// ══════════════════════════════════════════════════════════════
// §16 UNIFIED DASHBOARD — single table (was two separate tables)
// ══════════════════════════════════════════════════════════════
var table dash = table.new(f_pos(i_dpos), 2, 9,
     bgcolor=color.new(color.black,100), border_width=0, force_overlay=true)

if barstate.islast
    color _TR  = color.new(color.black,100)
    color _DIM = color.new(color.gray,20)
    string _dir  = sig_long?"▲ LONG":sig_short?"▼ SHORT":elong?"▲ WATCH":eshort?"▼ WATCH":"─ WAIT"
    string _gr   = econf>=80.?"A+":econf>=65.?"A":econf>=50.?"B":econf>=35.?"C":"D"
    color c_sig  = sig_long?color.lime:sig_short?color.red:elong?color.new(color.lime,50):eshort?color.new(color.red,50):_DIM
    color c_mtf  = mtf_sc>30.?color.lime:mtf_sc<-30.?color.red:color.orange
    color c_sc   = str.contains(scenario,"BULL") or str.contains(scenario,"MARKUP") or str.contains(scenario,"ACCUM") or str.contains(scenario,"SMART MONEY LONG")?color.lime: str.contains(scenario,"BEAR") or str.contains(scenario,"DUMP") or str.contains(scenario,"DIST") or str.contains(scenario,"BLOW") or str.contains(scenario,"WHALE") or str.contains(scenario,"CAPIT")?color.red:color.yellow
    color c_st   = mkt_stage==2?color.lime:mkt_stage==4?color.red:mkt_stage==1?color.yellow:_DIM
    float rr_now = elong?rr_L:rr_S
    string _ws2  = f_tfs(u_tf1)+(w_bull?"↑":w_bear?"↓":"─")
    string _ds2  = f_tfs(u_tf2)+(mtf_ds>1.?"↑":mtf_ds<-1.?"↓":"─")
    string _hs2  = f_tfs(u_tf3)+(mtf_hs>0.?"↑":mtf_hs<0.?"↓":"─")

    // R0: Header
    table.cell(dash,0,0,"SENTINEL SIGNAL v1.0", bgcolor=color.new(color.black,100),text_color=color.new(#ffb800,0),text_size=size.tiny)
    table.cell(dash,1,0,syminfo.ticker+"  "+timeframe.period, bgcolor=color.new(color.black,100),text_color=color.new(#ffb800,0),text_size=size.tiny)

    // R1: Signal + Grade + Confidence
    table.cell(dash,0,1,_dir+"  Grade:"+_gr, bgcolor=_TR,text_color=c_sig,text_size=size.tiny)
    table.cell(dash,1,1,"Conf:"+str.tostring(math.round(econf),"#")+"% | Sc:"+str.tostring(math.round(esc),"#"), bgcolor=_TR,text_color=c_sig,text_size=size.tiny)

    // R3: MTF Alignment
    table.cell(dash,0,3,"MTF  "+mtf_str+(mtf_flag?"  ⚠️":""), bgcolor=_TR,text_color=c_mtf,text_size=size.tiny)
    string _m52 = use_m5?("  5m"+(mtf_s5>0.?"↑":mtf_s5<0.?"↓":"─")):""
    table.cell(dash,1,3,_ws2+"  "+_ds2+"  "+_hs2+_m52+"  ("+str.tostring(math.round(mtf_sc),"#")+")", bgcolor=_TR,text_color=c_mtf,text_size=size.tiny)

    // R4: Momentum + Stage
    string mom_arrow = mom_rising?"↑":mom_falling?"↓":"→"
    table.cell(dash,0,4,"MOM "+mom_phase+" "+str.tostring(math.round(mom_str),"#")+"%"+mom_arrow, bgcolor=_TR,text_color=mom_sc>20.?color.lime:mom_sc<-20.?color.red:_DIM,text_size=size.tiny)
    table.cell(dash,1,4,stage_s+"  ADX:"+str.tostring(math.round(adx_v),"#")+"  PC:"+str.tostring(math.round(profit_chips),"#")+"%", bgcolor=_TR,text_color=c_st,text_size=size.tiny)

    // R5: Scenario + Structure
    table.cell(dash,0,5,"SCENARIO: "+scenario, bgcolor=_TR,text_color=c_sc,text_size=size.tiny)
    string bos_s = bos_bull?"BOS↑":bos_bear?"BOS↓":"─"
    string sw_s  = bull_sw?"Sw↑":bear_sw?"Sw↓":"─"
    string div_s = bull_div?"📐B":bear_div?"📐S":h_bull_div?"h+":h_bear_div?"h-":"─"
    string cvd_s = cvd_bull?"CVD↑":"CVD↓"
    table.cell(dash,1,5,bos_s+"  "+sw_s+"  Div:"+div_s+"  "+cvd_s, bgcolor=_TR,text_color=_DIM,text_size=size.tiny)

    // R6: Entry / SL / TP (T2 + R:R ตัดออกแล้ว)
    float sl_now = elong?sl_L:sl_S
    float t1_now = elong?tp1_L:tp1_S
    table.cell(dash,0,6,"SL:"+str.tostring(sl_now,"#.##")+"  T1:"+str.tostring(t1_now,"#.##"), bgcolor=_TR,text_color=_DIM,text_size=size.tiny)
    table.cell(dash,1,6,_dir, bgcolor=_TR,text_color=c_sig,text_size=size.tiny)

    // R7: Fibonacci position + wave target
    string fib_dir_s = fib_ok?(fib_dn?"⬇":"⬆"):"─"
    table.cell(dash,0,7,"FIB"+fib_dir_s+" "+fib_zone+ew_s+"  🎯"+(na(fib_tgt)?"─":str.tostring(fib_tgt,"#.#"))+"  P↑"+str.tostring(math.round(p_up),"#")+"%", bgcolor=_TR,text_color=fib_cont?color.fuchsia:_DIM,text_size=size.tiny)
    table.cell(dash,1,7,"WT:"+(wt_last==1?"▲":wt_last==-1?"▼":"─")+"  WTDiff:"+str.tostring(wt_diff,"#.0")+"  LC:"+str.tostring(math.round(lc_chips),"#")+"%", bgcolor=_TR,text_color=_DIM,text_size=size.tiny)

    // R8: Status message
    string status = sig_long or sig_short?(sig_long?"▲":"▼")+" SIGNAL — Entry:"+str.tostring(close,"#.##")+"  SL:"+str.tostring(sl_now,"#.##"): elong or eshort?"⏳ Forming "+str.tostring(math.round(econf),"#")+"% / need "+str.tostring(math.round(i_conf),"#")+"%": str.contains(scenario,"🚨")?"🚨 DANGER — "+scenario: mkt_stage==4?"🚨 S4 DIST — Avoid longs": mom_peak?"⚠️ MOM PEAK — Tighten stops": mtf_flag?"⚠️ TF CONFLICT — "+_ws2+" "+_ds2+" "+_hs2: early_bull?"🔥 MOM IGNITING — Long forming early":early_bear?"🌫 MOM TOPPING — Strength fading early": tm_bull_ok?"⚡ BULL REVERSAL — Trend↓ Mom↑": tm_bear_ok?"⚠️ BEAR REVERSAL — Trend↑ Mom↓": "😴 No setup — Monitor"
    color c_st2 = sig_long or sig_short?color.lime:str.contains(status,"🚨")?color.red:str.contains(status,"⚠️")?color.orange:_DIM
    table.cell(dash,0,8,status, bgcolor=_TR,text_color=c_st2,text_size=size.tiny)
    float ev = rr_now * (econf/100.) - (1. - econf/100.)
    table.cell(dash,1,8,"EV:"+str.tostring(ev,"+#.##")+"  Cd:"+str.tostring(_cd,"#")+" bars", bgcolor=_TR,text_color=_DIM,text_size=size.tiny)

// ══════════════════════════════════════════════════════════════
// §17 ALERTS — 12 conditions
// ══════════════════════════════════════════════════════════════
alertcondition(sig_long,                         "Sentinel: LONG ▲",       "▲ LONG | Conf:{{plot_3}}% | {{ticker}} {{interval}}")
alertcondition(sig_short,                        "Sentinel: SHORT ▼",      "▼ SHORT | Conf:{{plot_3}}% | {{ticker}} {{interval}}")
// PLOT-BUDGET FIX: legacy diagnostic alert disabled; core 3L/entry/pivot alerts retained.
// alertcondition(bos_bull,                         "Sentinel: BOS Bull 📈",   "📈 BOS BULL confirmed — Structure break up")
// PLOT-BUDGET FIX: legacy diagnostic alert disabled; core 3L/entry/pivot alerts retained.
// alertcondition(bos_bear,                         "Sentinel: BOS Bear 📉",   "📉 BOS BEAR confirmed — Structure break down")
// PLOT-BUDGET FIX: legacy diagnostic alert disabled; core 3L/entry/pivot alerts retained.
// alertcondition(mom_peak and not mom_peak[1],     "Sentinel: Mom Peak ⚠️",  "⚠️ MOMENTUM PEAK — Decel likely, tighten stops")
// PLOT-BUDGET FIX: legacy diagnostic alert disabled; core 3L/entry/pivot alerts retained.
// alertcondition(bull_div,                         "Sentinel: Bull Div 📐",   "📐 BULL DIVERGENCE at confirmed pivot low")
// PLOT-BUDGET FIX: legacy diagnostic alert disabled; core 3L/entry/pivot alerts retained.
