# ── Market data provider ──────────────────────────────────────────────
# Default is Yahoo Finance (free, NO API KEY needed).
#
# DATA_PROVIDER=yahoo
# DATA_PROVIDER=alphavantage

# Fundamentals & financial statements come from SEC EDGAR (free, no key).
SEC_USER_AGENT=EquityResearchWeb/1.0 (contact: you@example.com)

# Optional Alpha Vantage fallback.
ALPHA_VANTAGE_API_KEY=

# Optional Finnhub fallback quote.
FINNHUB_API_KEY=

# ── Supabase ─────────────────────────────────────────────────────────
# Public/read configuration.
NEXT_PUBLIC_SUPABASE_URL=https://jsxoydianiehgrwtaaas.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_fxLdQUPfS8R1unuEe2-Y9A_fIX3AFnY

# REQUIRED for secure server-side Watchlist/Holdings writes on Railway.
# Keep this variable server-only: NEVER prefix it with NEXT_PUBLIC_.
# Use the Supabase Secret key (preferred) or legacy service-role key.
SUPABASE_SECRET_KEY=
# Legacy compatibility:
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SERVICE_KEY=sb_secret_8Lr67Fm9DQwqIez51a845g_qTuHfq13

# Railway does NOT use Vercel Production OIDC. When SUPABASE_SECRET_KEY
# is configured, the server writes directly through the privileged
# server-side Supabase client; the browser never receives this secret.
