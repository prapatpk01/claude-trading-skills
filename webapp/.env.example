# ── Market data providers ─────────────────────────────────────────────
# Alpha Vantage (fundamentals, financial statements, daily prices, earnings)
# Get a free key: https://www.alphavantage.co/support/#api-key
# Falls back to the public "demo" key (IBM only) if unset.
ALPHA_VANTAGE_API_KEY=demo

# Finnhub (real-time quote, company profile, basic financials)
# Get a free key: https://finnhub.io/register
# Optional — the app degrades gracefully if unset.
FINNHUB_API_KEY=

# ── Supabase (portfolio + watchlist persistence) ──────────────────────
# Create a project: https://supabase.com/dashboard
# Run supabase/schema.sql in the SQL editor to create the tables.
# If these are unset, the app falls back to in-memory storage (dev only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key is used ONLY server-side for writes (never exposed to client)
SUPABASE_SERVICE_ROLE_KEY=
