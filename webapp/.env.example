# ── Market data provider ──────────────────────────────────────────────
# Default is Yahoo Finance (free, NO API KEY needed — same source as the
# Python `yfinance` library). Nothing to configure to get real data.
#
# DATA_PROVIDER=yahoo          # default; omit entirely to use Yahoo
# DATA_PROVIDER=alphavantage   # switch to Alpha Vantage (needs the key below)

# Only used when DATA_PROVIDER=alphavantage
# Get a free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Optional Finnhub fallback quote (only used in the alphavantage path)
FINNHUB_API_KEY=

# ── AI analysis (multi-provider, auto-rotation) ───────────────────────
# ALL keys are optional — add as many as you like. The app builds a fallback
# chain across every provider you configure, tries FREE tiers first, and
# auto-switches to the next model when one hits its limit.
#
# ▸ Real free API tiers (recommended — add these first):
GEMINI_API_KEY=          # https://aistudio.google.com/apikey     (Gemini 2.5 Flash/Pro)
GROQ_API_KEY=            # https://console.groq.com/keys          (Llama 3.3 70B, very fast)
CEREBRAS_API_KEY=        # https://cloud.cerebras.ai              (Llama 3.3 70B)
MISTRAL_API_KEY=         # https://console.mistral.ai/api-keys    (Mistral Large)
OPENROUTER_API_KEY=      # https://openrouter.ai/keys             (":free" models)
#
# ▸ Premium — NO free API tier, pay per token. Used only as last-resort
#   fallbacks after every free model above is exhausted.
ANTHROPIC_API_KEY=       # https://console.anthropic.com/settings/keys
OPENAI_API_KEY=          # https://platform.openai.com/api-keys

# Optional: override the whole chain. Format "provider:model|Label", comma-separated.
# AI_MODELS=gemini:gemini-2.5-flash|Gemini Flash,groq:llama-3.3-70b-versatile|Llama 70B

# ── Supabase (portfolio + watchlist persistence) ──────────────────────
# Create a project: https://supabase.com/dashboard
# Run supabase/schema.sql in the SQL editor to create the tables.
# If these are unset, the app falls back to in-memory storage (dev only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key is optional (server-side writes). The bundled RLS also
# allows the anon key, so the anon key alone is enough for personal use.
SUPABASE_SERVICE_ROLE_KEY=
